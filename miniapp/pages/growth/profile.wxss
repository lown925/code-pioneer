@import "../../app.wxss";

.growth-profile-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  padding: 34rpx 32rpx 38rpx;
  border-radius: 30rpx;
  background: linear-gradient(140deg, #17324d 0%, #1b6b78 58%, #43a6a1 100%);
  box-shadow: 0 20rpx 42rpx rgba(23, 86, 100, 0.18);
}

.profile-hero-eyebrow,
.profile-hero-title,
.profile-hero-copy {
  display: block;
}

.profile-hero-eyebrow {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.66);
}

.profile-hero-title {
  margin-top: 12rpx;
  font-size: 41rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile-hero-copy {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
}

.field-card {
  padding: 28rpx;
}

.field-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.field-title,
.field-copy {
  display: block;
}

.field-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17324d;
}

.field-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a8da9;
}

.clear-action {
  flex: 0 0 auto;
  padding: 8rpx 4rpx 8rpx 18rpx;
  font-size: 22rpx;
  color: #8192a8;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.option-chip {
  min-height: 64rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f2f6fb;
  color: #536c8c;
  font-size: 23rpx;
  line-height: 1.35;
}

.option-chip-selected {
  background: #e7f5f3;
  color: #176c66;
  box-shadow: inset 0 0 0 2rpx rgba(36, 117, 111, 0.2);
  font-weight: 600;
}

.custom-input {
  width: 100%;
  height: 82rpx;
  margin-top: 20rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f5f8fc;
  color: #17324d;
  font-size: 25rpx;
  box-shadow: inset 0 0 0 1rpx rgba(47, 107, 255, 0.08);
}

.selected-custom-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.selected-custom-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 58rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 22rpx;
}

.selected-custom-remove {
  font-size: 28rpx;
  line-height: 1;
}

.custom-add-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.custom-add-input {
  flex: 1;
  min-width: 0;
  margin-top: 0;
}

.custom-add-button {
  flex: 0 0 auto;
  min-height: 82rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.submit-error {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff3f2;
  color: #b34e47;
  font-size: 24rpx;
  line-height: 1.65;
}

.save-button {
  margin: 2rpx 0 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #176c66 0%, #43a6a1 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 90rpx;
  box-shadow: 0 16rpx 30rpx rgba(36, 117, 111, 0.22);
}

.save-button::after {
  border: none;
}

.save-button[disabled] {
  opacity: 0.64;
}
