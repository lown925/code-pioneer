@import "../../app.wxss";

.growth-page { display: flex; flex-direction: column; gap: 24rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.growth-header { padding: 10rpx 4rpx 4rpx; }
.growth-eyebrow { display: block; color: var(--color-primary); font-size: 21rpx; font-weight: 700; letter-spacing: 5rpx; }
.growth-title { display: block; margin-top: 10rpx; color: var(--color-text-primary); font-size: 48rpx; font-weight: 700; line-height: 1.25; }
.growth-copy { display: block; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 25rpx; line-height: 1.6; }
.state-action { margin-top: 8rpx; }
.profile-panel { padding: 26rpx 30rpx; }
.panel-heading, .section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.recommendation-priority { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 20rpx; font-weight: 600; }
.profile-summary { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.profile-summary-primary { color: var(--color-text-primary); font-size: 28rpx; font-weight: 700; }
.profile-summary-focus { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.profile-summary-direction { color: var(--color-text-secondary); font-size: 23rpx; }
.profile-summary-career, .profile-incomplete-copy { color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.6; }
.profile-incomplete-copy { display: block; margin-top: 14rpx; }
.interest-tag { padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 21rpx; }
.profile-action { display: flex; margin-top: 20rpx; }
.goal-section { border-color: var(--color-primary); }
.goal-status { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 20rpx; font-weight: 600; }
.goal-status-BEHIND { background: var(--color-danger-soft); color: var(--color-danger); }
.goal-status-AHEAD { background: var(--color-success-soft); color: var(--color-success); }
.goal-course-title { margin-top: 24rpx; color: var(--color-text-primary); font-size: 32rpx; font-weight: 700; }
.goal-target { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.goal-progress-meta, .goal-detail-row, .goal-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.goal-progress-meta { margin-top: 26rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.goal-progress { height: 16rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-bg-secondary); }
.goal-progress-fill { height: 100%; border-radius: inherit; background: var(--color-primary); }
.goal-detail-row { margin-top: 14rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; }
.goal-detail-row text:first-child { color: var(--color-text-primary); font-weight: 600; }
.goal-actions { flex-wrap: wrap; justify-content: flex-start; margin-top: 24rpx; }
.goal-action { min-height: 68rpx; padding: 0 24rpx; font-size: 23rpx; }
.goal-cancel { margin-left: auto; color: var(--color-danger); font-size: 22rpx; }
.goal-empty { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 22rpx; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.5; }
.goal-empty .goal-action { flex: 0 0 auto; }
.goal-modal-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: var(--color-overlay); }
.goal-modal { width: 100%; box-sizing: border-box; padding: 32rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: var(--color-card); }
.goal-modal-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.goal-modal-close { color: var(--color-text-secondary); font-size: 23rpx; }
.goal-field { display: flex; align-items: center; justify-content: space-between; min-height: 84rpx; padding: 0 20rpx; margin-top: 14rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; color: var(--color-text-primary); font-size: 24rpx; }
.goal-field text:last-child { color: var(--color-primary); }
.goal-save { width: 100%; margin-top: 24rpx; }
.growth-section { padding: 28rpx 30rpx; border: 1rpx solid var(--color-border); border-radius: 24rpx; background: var(--color-card); }
.course-recommendation-section, .recommendation-section { border-color: var(--color-primary); }
.course-recommendation-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 20rpx; }
.course-recommendation-row, .course-recommendation-empty { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; border-radius: 18rpx; background: var(--color-card-subtle); }
.course-recommendation-copy { min-width: 0; }
.course-recommendation-title { display: block; color: var(--color-text-primary); font-size: 26rpx; font-weight: 700; }
.course-recommendation-reason, .course-recommendation-empty { color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.55; }
.course-recommendation-reason { display: block; margin-top: 7rpx; }
.professional-route-section { border-color: var(--color-border); }
.professional-route-list { display: flex; flex-direction: column; margin-top: 18rpx; }
.professional-route-row { display: flex; align-items: center; gap: 16rpx; min-height: 82rpx; border-bottom: 1rpx solid var(--color-border); }
.professional-route-row:last-child { border-bottom: 0; }
.professional-route-clickable:active { opacity: 0.72; }
.professional-route-index { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--color-primary-soft); color: var(--color-primary); font-size: 22rpx; font-weight: 700; }
.professional-route-copy { min-width: 0; flex: 1; }
.professional-route-title, .professional-route-status { display: block; }
.professional-route-title { color: var(--color-text-primary); font-size: 25rpx; font-weight: 600; }
.professional-route-status { margin-top: 5rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.recommendation-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 22rpx; }
.recommendation-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx; border-radius: 18rpx; background: var(--color-card-subtle); }
.recommendation-copy { min-width: 0; }
.recommendation-title-line { display: flex; align-items: center; gap: 10rpx; }
.recommendation-title { min-width: 0; color: var(--color-text-primary); font-size: 27rpx; font-weight: 700; }
.recommendation-reason { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.55; }
.recommendation-action, .section-link { flex: 0 0 auto; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.priority-HIGH .recommendation-priority { background: var(--color-danger-soft); color: var(--color-danger); }
.priority-MEDIUM .recommendation-priority { background: var(--color-warning-soft); color: var(--color-warning); }
.range-switcher { display: flex; padding: 4rpx; border-radius: 999rpx; background: var(--color-card-subtle); }
.range-option { padding: 8rpx 16rpx; border-radius: 999rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.range-option.is-active { background: var(--color-primary); color: var(--color-text-inverse); }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 24rpx; }
.summary-item { min-width: 0; padding: 16rpx 8rpx; border-radius: 16rpx; background: var(--color-card-subtle); text-align: center; }
.summary-value { display: block; color: var(--color-text-primary); font-size: 31rpx; font-weight: 700; }
.summary-label { display: block; margin-top: 6rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.chapter-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.chapter-row { min-width: 0; }
.chapter-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.chapter-name-wrap { min-width: 0; }
.chapter-name, .chapter-course, .chapter-status { display: block; }
.chapter-name { overflow: hidden; color: var(--color-text-primary); font-size: 25rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.chapter-course, .chapter-status { margin-top: 5rpx; color: var(--color-text-tertiary); font-size: 20rpx; }
.chapter-score-wrap { flex: 0 0 auto; text-align: right; }
.chapter-score { display: block; color: var(--color-text-primary); font-size: 27rpx; font-weight: 700; }
.chapter-bar { height: 12rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-bg-secondary); }
.chapter-bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--color-primary), var(--color-primary-accent)); }
.weak-area-list, .battle-mode-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 20rpx; }
.course-filter, .skill-filter { display: flex; width: 100%; margin-top: 20rpx; white-space: nowrap; }
.course-filter-item, .skill-filter-item { display: inline-block; padding: 10rpx 18rpx; margin-right: 10rpx; border-radius: 999rpx; background: var(--color-card-subtle); color: var(--color-text-secondary); font-size: 22rpx; }
.course-filter-item.is-active, .skill-filter-item.is-active { background: var(--color-primary-soft); color: var(--color-primary); font-weight: 700; }
.weak-area-row, .battle-mode-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--color-border); color: var(--color-text-primary); font-size: 23rpx; }
.weak-area-copy { min-width: 0; }
.weak-area-name, .weak-area-course { display: block; }
.weak-area-course { margin-top: 4rpx; color: var(--color-text-tertiary); font-size: 19rpx; }
.weak-area-chart { display: flex; align-items: center; gap: 12rpx; flex: 1; justify-content: flex-end; }
.weak-area-track { width: 180rpx; height: 10rpx; overflow: hidden; border-radius: 999rpx; background: var(--color-bg-secondary); }
.weak-area-fill { height: 100%; border-radius: inherit; background: var(--color-primary-accent); }
.weak-area-value, .battle-mode-row text:last-child { flex: 0 0 auto; color: var(--color-text-secondary); }
.battle-summary { margin-top: 22rpx; }
.battle-primary { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; padding: 20rpx; border-radius: 18rpx; background: var(--color-primary-soft); }
.battle-rating-high { color: var(--color-text-secondary); font-size: 21rpx; }
.battle-rating-label { color: var(--color-text-secondary); font-size: 23rpx; }
.battle-rating-value { color: var(--color-primary); font-size: 40rpx; font-weight: 700; }
.rating-note { margin-top: 16rpx; color: var(--color-text-tertiary); font-size: 20rpx; }
.inline-empty { padding: 26rpx 0 4rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.65; }

.performance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-bottom: 24rpx; }
.performance-card { min-width: 0; padding: 20rpx; border: 1rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-card-subtle); }
.performance-card-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.performance-card-title { color: var(--color-text-primary); font-size: 25rpx; font-weight: 700; }
.performance-card-score { color: var(--color-primary); font-size: 30rpx; font-weight: 700; }
.performance-card-meta, .performance-card-detail { display: block; margin-top: 10rpx; color: var(--color-text-secondary); font-size: 21rpx; line-height: 1.45; }
.performance-card-detail { color: var(--color-text-tertiary); }
.rating-trend { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); }
.rating-trend-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; }
.rating-trend-title { color: var(--color-text-primary); font-size: 23rpx; font-weight: 700; }
.learning-trend { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid var(--color-border); }
.learning-trend-title { display: block; margin-bottom: 8rpx; color: var(--color-text-primary); font-size: 23rpx; font-weight: 700; }
