@import "../../app.wxss";

.growth-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.growth-hero {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx 42rpx;
  border-radius: 32rpx;
  background: linear-gradient(140deg, #17324d 0%, #1b6b78 58%, #43a6a1 100%);
  box-shadow: 0 22rpx 46rpx rgba(23, 86, 100, 0.2);
}

.growth-hero::after {
  content: "";
  position: absolute;
  top: -74rpx;
  right: -42rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.growth-eyebrow,
.growth-title,
.growth-copy {
  position: relative;
  z-index: 1;
  display: block;
}

.growth-eyebrow {
  font-size: 22rpx;
  letter-spacing: 5rpx;
  color: rgba(255, 255, 255, 0.68);
}

.growth-title {
  margin-top: 12rpx;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.growth-copy {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.state-action {
  margin-top: 8rpx;
}

.profile-panel,
.analysis-panel {
  padding: 30rpx;
}

.panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-status {
  flex: 0 0 auto;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: 20rpx;
  font-weight: 600;
}

.profile-list {
  margin-top: 26rpx;
  border-top: 1rpx solid rgba(23, 50, 77, 0.08);
}

.profile-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(23, 50, 77, 0.08);
}

.profile-row-stack {
  flex-direction: column;
  gap: 14rpx;
}

.profile-label {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.profile-value {
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  line-height: 1.6;
  font-weight: 600;
  color: var(--color-text-primary);
}

.interest-tags,
.source-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.interest-tag,
.source-tag {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 21rpx;
}

.profile-action {
  display: flex;
  margin-top: 26rpx;
}

.analysis-panel {
  background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-subtle) 100%);
}

.analysis-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.analysis-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--color-text-secondary);
}

.source-tags {
  margin-top: 22rpx;
}

.source-tag {
  background: var(--color-success-soft);
  color: var(--color-success);
}
