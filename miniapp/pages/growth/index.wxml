<view class="page-shell growth-page theme-{{resolvedTheme}}">
  <battle-match-floating />
  <view class="growth-header">
    <view>
      <text class="growth-eyebrow">学习成长分析</text>
      <text class="growth-title">成长中心</text>
      <text class="growth-copy">用真实学习记录，决定下一步怎么学。</text>
    </view>
  </view>

  <view wx:if="{{state === 'guest'}}" class="section-card state-box">
    <text class="state-title">登录后建立成长分析</text>
    <text class="state-text">完成课程、练习或对战后，这里会逐步形成你的成长分析。</text>
    <view class="primary-button state-action" bindtap="handleLogin">微信登录</view>
  </view>

  <view wx:elif="{{state === 'loading'}}" class="section-card state-box">
    <text class="state-title">正在整理成长数据</text>
    <text class="state-text">正在同步你的课程、答题和对战记录。</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="section-card state-box">
    <text class="state-title">暂时无法读取成长分析</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="ghost-button state-action" bindtap="handleRetry">重新加载</view>
  </view>

  <block wx:elif="{{state === 'success'}}">
    <view class="section-card profile-panel">
      <block wx:if="{{profile && profile.isCoreProfileComplete}}">
        <view class="panel-heading">
          <text class="section-title">学习画像</text>
          <text class="section-link" bindtap="handleEditProfile">编辑 ›</text>
        </view>
        <view class="profile-summary">
          <text class="profile-summary-primary">{{profileMajorText}} · {{profileGradeText}}</text>
          <view class="profile-summary-focus">
            <text class="profile-summary-direction">{{profileDirectionText}}</text>
            <text wx:for="{{profileInterestTexts}}" wx:key="*this" class="interest-tag">{{item}}</text>
          </view>
          <text class="profile-summary-career">职业方向：{{profileCareerText}}</text>
        </view>
      </block>
      <block wx:else>
        <text class="section-title">完善学习画像</text>
        <text class="profile-incomplete-copy">告诉我们你的专业、学习方向和职业目标，为你推荐更适合的课程。</text>
        <view class="primary-button profile-action" bindtap="handleEditProfile">完善画像</view>
      </block>
    </view>

    <view class="growth-section ai-prompt-section">
      <view class="section-heading"><view><text class="section-title">AI 成长顾问</text><text class="section-subtitle">根据你的专业、学习进度和职业目标，生成专属 AI 咨询提示词。</text></view></view>
      <text class="ai-prompt-hint">可复制到 ChatGPT、DeepSeek、豆包、Kimi 等 AI 工具使用</text>
      <view wx:if="{{aiPromptError}}" class="ai-prompt-error">{{aiPromptError}}</view>
      <scroll-view wx:if="{{aiPrompt}}" scroll-y class="ai-prompt-content"><text class="ai-prompt-text" selectable="true">{{aiPrompt}}</text></scroll-view>
      <text class="ai-prompt-privacy">提示词仅包含学习画像与学习记录，不包含账号身份信息。</text>
      <view class="ai-prompt-actions">
        <view wx:if="{{aiPrompt}}" class="ghost-button ai-prompt-action {{aiPromptLoading ? 'button-disabled' : ''}}" bindtap="handleCopyAiPrompt">复制提示词</view>
        <view class="{{aiPrompt ? 'ghost-button' : 'primary-button'}} ai-prompt-action {{aiPromptLoading ? 'button-disabled' : ''}}" bindtap="handleGenerateAiPrompt">{{aiPromptLoading ? '生成中...' : aiPrompt ? '重新生成' : aiPromptError ? '重试' : '生成提示词'}}</view>
      </view>
    </view>

    <view wx:if="{{continueLearning}}" class="growth-section course-recommendation-section">
      <view class="section-heading"><view><text class="section-title">继续学习</text><text class="section-subtitle">从你正在学习的课程继续</text></view></view>
      <view class="course-recommendation-row" data-path="/pages/learning/course-progress?courseId={{continueLearning.courseId}}" bindtap="handleRecommendationTap">
        <view class="course-recommendation-copy"><text class="course-recommendation-title">{{continueLearning.courseTitle}}</text><text class="course-recommendation-reason">已完成 {{continueLearning.progressPercent}}%</text></view>
        <text class="section-link">继续学习 ›</text>
      </view>
    </view>

    <view wx:if="{{nextRecommendation}}" class="growth-section course-recommendation-section">
      <view class="section-heading"><view><text class="section-title">下一步推荐</text><text class="section-subtitle">沿着你的专业核心课程路线继续</text></view></view>
      <view class="course-recommendation-row" data-path="{{nextRecommendation.targetPath}}" bindtap="handleRecommendationTap">
        <view class="course-recommendation-copy"><text class="course-recommendation-title">{{nextRecommendation.courseTitle}}</text><text class="course-recommendation-reason">{{nextRecommendation.reason}}</text></view>
        <text class="section-link">查看课程 ›</text>
      </view>
    </view>

    <view wx:if="{{professionalRoute.length}}" class="growth-section professional-route-section">
      <view class="section-heading"><view><text class="section-title">专业学习路线</text><text class="section-subtitle">{{profile.professionalTrack.formalName}}</text></view></view>
      <view class="professional-route-list">
        <view wx:for="{{professionalRoute}}" wx:key="slug" class="professional-route-row {{item.targetPath ? 'professional-route-clickable' : ''}}" data-path="{{item.targetPath}}" bindtap="handleRecommendationTap">
          <text class="professional-route-index">{{index + 1}}</text>
          <view class="professional-route-copy"><text class="professional-route-title">{{item.courseTitle}}</text><text class="professional-route-status">{{item.status === 'LEARNING' ? '学习中 · ' + item.progressPercent + '%' : item.status === 'COMPLETED' ? '已完成' : item.status === 'AVAILABLE' ? '可学习' : '待开放'}}</text></view>
        </view>
      </view>
    </view>

    <view class="growth-section goal-section">
      <view class="section-heading">
        <view><text class="section-title">我的学习目标</text><text class="section-subtitle">用课程进度安排下一步学习</text></view>
        <text wx:if="{{goal}}" class="goal-status goal-status-{{goal.paceStatus}}">{{goalStatusText}}</text>
      </view>
      <block wx:if="{{goal}}">
        <view class="goal-course-title">{{goal.courseTitle}}</view>
        <view class="goal-target">目标：{{goalTargetText}}</view>
        <view class="goal-progress-meta"><text>{{goalRemainingText}}</text><text>{{goal.progressPercent}}%</text></view>
        <view class="goal-progress"><view class="goal-progress-fill" style="width: {{goalProgressWidth}};"></view></view>
        <view class="goal-detail-row"><text>{{goalPaceText}}</text><text>{{goalCadenceText}}</text></view>
        <view class="goal-actions"><view class="primary-button goal-action" bindtap="handleContinueGoal">继续学习</view><view class="ghost-button goal-action" bindtap="openGoalEditor">调整目标</view><view class="goal-cancel" bindtap="handleCancelGoal">取消目标</view></view>
      </block>
      <view wx:else class="goal-empty"><text>设定一个课程目标，让成长中心帮你安排学习节奏。</text><view class="primary-button goal-action" bindtap="openGoalEditor">设置目标</view></view>
    </view>

    <view class="growth-section recommendation-section" wx:if="{{hasRecommendations}}">
      <view class="section-heading"><view><text class="section-title">下一步建议</text><text class="section-subtitle">根据当前样本生成，最多展示三条</text></view></view>
      <view class="recommendation-list">
        <view wx:for="{{recommendations}}" wx:key="type" class="recommendation-row priority-{{item.priority}}" data-path="{{item.targetPath}}" bindtap="handleRecommendationTap">
          <view class="recommendation-copy">
            <view class="recommendation-title-line"><text class="recommendation-title">{{item.title}}</text><text class="recommendation-priority">{{item.priorityText}}</text></view>
            <text class="recommendation-reason">{{item.reason}}</text>
          </view>
          <text class="recommendation-action">{{item.actionLabel}} ›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{hasPerformanceData}}" class="growth-section performance-section">
      <view class="section-heading">
        <view><text class="section-title">学习表现</text><text class="section-subtitle">{{rangeText}} · 按章节合并章节测验与已完成练习室</text></view>
        <view class="range-switcher"><view class="range-option {{range === '7d' ? 'is-active' : ''}}" data-range="7d" bindtap="handleRangeChange">7 天</view><view class="range-option {{range === '30d' ? 'is-active' : ''}}" data-range="30d" bindtap="handleRangeChange">30 天</view></view>
      </view>
      <view class="performance-grid">
        <view wx:if="{{hasQuizData}}" class="performance-card">
          <view class="performance-card-heading"><text class="performance-card-title">章节测验</text><text class="performance-card-score">{{quizAccuracyText}}</text></view>
          <text class="performance-card-meta">{{quizAttemptText}} · {{quizAnsweredText}}</text>
          <text class="performance-card-detail">{{quizCorrectText}}</text>
        </view>
        <view wx:if="{{hasPracticeData}}" class="performance-card">
          <view class="performance-card-heading"><text class="performance-card-title">练习室</text><text class="performance-card-score">{{practiceAccuracyText}}</text></view>
          <text class="performance-card-meta">{{practiceAttemptText}} · {{practiceAnsweredText}}</text>
          <text class="performance-card-detail">{{practiceCompletedText}} · {{practiceCorrectText}}</text>
        </view>
      </view>
      <view wx:if="{{hasChapterData}}" class="chapter-list">
        <view wx:for="{{chapterItems}}" wx:key="chapterId" class="chapter-row">
          <view class="chapter-meta"><view class="chapter-name-wrap"><text class="chapter-name">{{item.chapterTitle}}</text><text class="chapter-course">{{item.courseTitle}}</text></view><view class="chapter-score-wrap"><text class="chapter-score">{{item.scoreText}}</text><text class="chapter-status">{{item.statusText}} · {{item.sampleText}}</text></view></view>
          <view class="chapter-bar"><view class="chapter-bar-fill" style="width: {{item.barWidth}};"></view></view>
        </view>
      </view>
      <view wx:else class="inline-empty">完成足够的章节测验或练习室后，这里会显示章节表现。</view>
      <view wx:if="{{hasQuizData || hasPracticeData}}" class="learning-trend">
        <text class="learning-trend-title">学习趋势</text>
        <growth-line-chart wx:if="{{hasTrendData}}" points="{{trend}}" chart-mode="learning" resolved-theme="{{resolvedTheme}}" />
        <view wx:else class="inline-empty">继续完成一些章节测验或练习室后，这里会显示学习趋势。</view>
      </view>
    </view>

    <view wx:if="{{hasWrongData}}" class="growth-section wrong-section">
      <view class="section-heading"><view><text class="section-title">错题分析</text><text class="section-subtitle">按课程查看最常出错的章节</text></view><text class="section-link" data-path="/pages/wrong-question/index" bindtap="handleRecommendationTap">查看全部 ›</text></view>
      <view class="summary-grid"><view class="summary-item"><text class="summary-value">{{wrongQuestionText}}</text><text class="summary-label">不同错题</text></view><view class="summary-item"><text class="summary-value">{{wrongAttemptText}}</text><text class="summary-label">错误次数</text></view><view class="summary-item"><text class="summary-value">{{repeatedWrongText}}</text><text class="summary-label">重复错误</text></view></view>
      <scroll-view wx:if="{{wrongCourseFilters.length > 1}}" scroll-x class="course-filter"><view wx:for="{{wrongCourseFilters}}" wx:key="id" class="course-filter-item {{item.id === selectedWrongCourseId ? 'is-active' : ''}}" data-course-id="{{item.id}}" bindtap="handleWrongCourseChange">{{item.title}}</view></scroll-view>
      <view wx:if="{{wrongAreaItems.length}}" class="weak-area-list"><view wx:for="{{wrongAreaItems}}" wx:key="chapterId" class="weak-area-row"><view class="weak-area-copy"><text class="weak-area-name">{{item.chapterTitle}}</text><text class="weak-area-course">{{item.courseTitle}}</text></view><view class="weak-area-chart"><view class="weak-area-track"><view class="weak-area-fill" style="width: {{item.barWidth}};"></view></view><text class="weak-area-value">{{item.wrongText}}</text></view></view></view>
      <view wx:else class="inline-empty">暂无可分类的错题样本。</view>
    </view>

    <view wx:if="{{hasBattleData}}" class="growth-section battle-section">
      <view class="section-heading"><view><text class="section-title">对战</text><text class="section-subtitle">竞技、训练和好友对战分开统计</text></view><text class="section-link" data-path="/pages/battle/index" bindtap="handleRecommendationTap">进入对战 ›</text></view>
      <view class="battle-summary">
        <scroll-view wx:if="{{trackItems.length}}" scroll-x class="skill-filter"><view wx:for="{{trackItems}}" wx:key="trackKey" class="skill-filter-item {{item.trackKey === selectedTrackKey ? 'is-active' : ''}}" data-track-key="{{item.trackKey}}" bindtap="handleTrackChange">{{item.shortName}}</view></scroll-view>
        <view wx:if="{{selectedTrack}}" class="battle-primary"><view><text class="battle-rating-label">{{selectedTrack.shortName}}专业积分</text><text class="battle-rating-value">{{currentRatingText}}</text></view><text class="battle-rating-high">最高 {{highestRatingText}}</text></view>
        <view class="battle-mode-list"><view class="battle-mode-row"><text>随机匹配</text><text>{{rankedBattleText}}</text></view><view class="battle-mode-row"><text>训练</text><text>{{trainingBattleText}}</text></view><view class="battle-mode-row"><text>好友对战</text><text>{{friendBattleText}}</text></view></view>
        <view wx:if="{{selectedTrack && hasRatingTrend}}" class="rating-trend"><view class="rating-trend-heading"><text class="rating-trend-title">专业积分趋势</text><text class="rating-note">最近 {{ratingChartPoints.length}} 场 · 净变化 {{ratingNetChangeText}}</text></view><growth-line-chart rating-points="{{ratingChartPoints}}" chart-mode="rating" resolved-theme="{{resolvedTheme}}" /></view>
        <view wx:elif="{{selectedTrack}}" class="inline-empty">{{ratingEmptyText}}</view>
      </view>
    </view>

    <view wx:if="{{goalEditorOpen}}" class="goal-modal-mask" catchtap="closeGoalEditor"><view class="goal-modal" catchtap="stopGoalModalTap"><view class="goal-modal-heading"><text class="section-title">{{goal ? '调整学习目标' : '设置学习目标'}}</text><text class="goal-modal-close" bindtap="closeGoalEditor">关闭</text></view><picker mode="selector" range="{{goalCourseLabels}}" value="{{goalCourseIndex}}" bindchange="handleGoalCourseChange"><view class="goal-field"><text>课程</text><text>{{goalCourseLabels[goalCourseIndex]}}</text></view></picker><picker mode="date" start="{{goalFormTargetDate}}" value="{{goalFormTargetDate}}" bindchange="handleGoalDateChange"><view class="goal-field"><text>完成日期</text><text>{{goalFormTargetDate}}</text></view></picker><view class="primary-button goal-save" bindtap="saveGoal">{{isGoalSaving ? '保存中...' : '立即保存'}}</view></view></view>
  </block>
</view>
