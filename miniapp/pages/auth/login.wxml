<view class="page-shell login-page">
  <view class="section-card hero-card">
    <text class="hero-eyebrow">USER AUTH</text>
    <text class="hero-title">Sign in before using USER APIs</text>
    <text class="hero-copy">
      This stage only connects authentication and the shared request layer. The learning pages themselves are still part of later tasks.
    </text>
  </view>

  <view class="section-card auth-card">
    <text class="section-title">WeChat Login</text>
    <text class="section-subtitle">Production uses `wx.login` to exchange a real user identity.</text>
    <button
      class="action-button action-button-primary"
      loading="{{isWechatSubmitting}}"
      disabled="{{isWechatSubmitting || isMockSubmitting}}"
      bindtap="handleWechatLogin"
    >
      Sign in with WeChat
    </button>
  </view>

  <view wx:if="{{showMockLogin}}" class="section-card auth-card mock-card">
    <text class="section-title">Development Mock Login</text>
    <text class="section-subtitle">
      Visible only in development. The request body remains `{ code, mockOpenId }` on the same official endpoint.
    </text>

    <view class="field-group">
      <text class="field-label">mockOpenId</text>
      <input
        class="field-input"
        type="text"
        maxlength="128"
        value="{{mockOpenId}}"
        placeholder="mock-openid-dev-user-001"
        bindinput="handleMockOpenIdInput"
      />
    </view>

    <button
      class="action-button action-button-secondary"
      loading="{{isMockSubmitting}}"
      disabled="{{isWechatSubmitting || isMockSubmitting}}"
      bindtap="handleMockLogin"
    >
      Sign in with Mock
    </button>
  </view>

  <view wx:if="{{errorMessage}}" class="section-card error-card">
    <text class="error-title">Login Failed</text>
    <text class="error-text">{{errorMessage}}</text>
  </view>
</view>
