<view class="page-shell login-page">
  <view class="section-card hero-card">
    <text class="hero-eyebrow">统一认证</text>
    <text class="hero-title">微信登录</text>
    <text class="hero-copy">使用微信身份登录码站先锋。</text>
  </view>

  <view class="section-card auth-card">
    <text class="section-title">微信登录</text>
    <text class="section-subtitle">正式环境使用 `wx.login` 获取临时凭证并完成登录。</text>
    <button
      class="action-button action-button-primary"
      loading="{{isWechatSubmitting}}"
      disabled="{{isWechatSubmitting}}"
      bindtap="handleWechatLogin"
    >
      微信授权登录
    </button>
  </view>

  <view wx:if="{{showTestLogin}}" class="section-card test-auth-card">
    <text class="section-title">测试登录</text>
    <view class="test-login-actions">
      <button
        class="action-button action-button-secondary"
        loading="{{testSubmittingOpenId === 'test-player-a'}}"
        disabled="{{isWechatSubmitting || testSubmittingOpenId}}"
        bindtap="handleTestPlayerALogin"
      >
        测试玩家 A
      </button>
      <button
        class="action-button action-button-secondary"
        loading="{{testSubmittingOpenId === 'test-player-b'}}"
        disabled="{{isWechatSubmitting || testSubmittingOpenId}}"
        bindtap="handleTestPlayerBLogin"
      >
        测试玩家 B
      </button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="section-card error-card">
    <text class="error-title">登录失败</text>
    <text class="error-text">{{errorMessage}}</text>
  </view>

</view>
