@import "../../app.wxss";

.login-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.auth-card,
.test-auth-card,
.error-card {
  padding: 32rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 24rpx;
  font-size: 40rpx;
  line-height: 1.4;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.86);
}

.action-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.action-button::after {
  border: none;
}

.action-button-primary {
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
}

.test-login-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 28rpx;
}

.test-login-actions .action-button {
  width: 100%;
  margin-top: 0;
}

.action-button-secondary {
  background: #edf4ff;
  color: #17324d;
  border: 2rpx solid #bfd3f4;
}

.error-card {
  background: #fff5f5;
}

.error-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #9f1239;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #7f1d1d;
}
