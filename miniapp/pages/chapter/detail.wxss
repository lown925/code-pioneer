@import "../../app.wxss";

.chapter-detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.reader-top {
  display: block;
}

.top-center {
  min-width: 0;
  text-align: center;
}

.top-center-wide {
  padding: 0 92rpx;
}

.top-course,
.top-position {
  display: block;
}

.top-course {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.top-position {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.chapter-overview-card,
.content-card,
.chapter-nav-card,
.catalog-sheet,
.chapter-action-card {
  padding: 30rpx;
}

.chapter-overview-course {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.chapter-overview-title {
  display: block;
  margin-top: 14rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-text-primary);
}

.chapter-overview-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.chapter-overview-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.chapter-overview-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  font-size: 22rpx;
  color: var(--color-primary);
}

.chapter-overview-pill-status.status-learning {
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

.chapter-overview-pill-status.status-completed {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.chapter-overview-pill-status.status-not-started {
  background: var(--color-bg-secondary);
  color: var(--color-text-tertiary);
}

.content-block-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.heading-card {
  background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-elevated) 100%);
}

.heading-text {
  display: block;
  color: var(--color-text-primary);
}

.heading-level-1 {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.heading-level-2 {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.heading-level-3 {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.paragraph-text,
.callout-text,
.example-description,
.example-text,
.image-alt,
.image-caption,
.code-caption,
.example-caption,
.chapter-action-description {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-primary);
  white-space: pre-wrap;
}

.callout-card {
  border-left: 8rpx solid var(--color-primary);
  background: var(--color-card-subtle);
}

.callout-warning {
  border-left-color: var(--color-warning);
  background: var(--color-warning-soft);
}

.callout-title,
.example-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.callout-text,
.example-description,
.example-text,
.image-alt,
.image-caption,
.code-caption,
.chapter-action-description {
  margin-top: 12rpx;
}

.example-description {
  color: var(--color-text-secondary);
  font-weight: 600;
}

.code-card {
  background: var(--color-code-bg);
}

.code-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.code-language {
  font-size: 22rpx;
  text-transform: uppercase;
  color: #93c5fd;
  letter-spacing: 2rpx;
}

.code-copy-button {
  min-height: 60rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.12);
  color: var(--color-text-inverse);
}

.code-caption {
  color: #cbd5e1;
}

.code-scroll {
  margin-top: 18rpx;
  width: 100%;
}

.code-content {
  min-width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.06);
  font-family: "Courier New", monospace;
  font-size: 24rpx;
  line-height: 1.8;
  color: #f8fafc;
  white-space: pre;
}

.content-image {
  width: 100%;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--color-primary-soft);
}

.image-alt {
  color: var(--color-text-primary);
  font-weight: 600;
}

.example-card {
  background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-elevated) 100%);
}

.chapter-action-card {
  margin-top: 4rpx;
}

.chapter-primary-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #17324d;
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.chapter-primary-button::after {
  border: none;
}

.chapter-nav-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  gap: 16rpx;
  align-items: stretch;
  margin-top: 8rpx;
}

.nav-action {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--color-primary-soft);
}

.nav-action-next {
  text-align: right;
}

.nav-action-disabled {
  opacity: 0.5;
}

.nav-action-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.nav-action-title {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.nav-position {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 168rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #17324d;
}

.nav-position-text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
}

.catalog-mask {
  position: fixed;
  inset: 0;
  background: rgba(9, 18, 33, 0.36);
  z-index: 40;
}

.catalog-fab {
  position: fixed;
  right: 24rpx;
  bottom: calc(212rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(238, 244, 255, 0.96);
  box-shadow: 0 18rpx 38rpx rgba(23, 50, 77, 0.14);
}

.catalog-fab-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.catalog-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  border-radius: 32rpx;
  background: var(--color-card);
  box-shadow: 0 24rpx 60rpx rgba(23, 50, 77, 0.18);
  max-height: 70vh;
  overflow: hidden;
  z-index: 50;
}

.catalog-sheet-head {
  padding-bottom: 20rpx;
}

.catalog-sheet-title,
.catalog-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.catalog-sheet-subtitle,
.catalog-subtitle,
.catalog-current {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.catalog-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: calc(70vh - 120rpx);
  overflow: auto;
}

.catalog-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.catalog-item-current {
  background: var(--color-primary-soft);
}

.catalog-order {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  flex-shrink: 0;
}

.catalog-main {
  flex: 1;
  min-width: 0;
}

.catalog-current {
  margin-top: 0;
  color: var(--color-primary);
  font-weight: 700;
}
