@import "../../app.wxss";

.chapter-quiz-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

.hero-card,
.question-card,
.footer-card {
  padding: 30rpx;
}

.hero-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.hero-description,
.hero-meta,
.hero-score,
.hero-hint,
.question-content,
.option-content,
.result-answer,
.result-explanation {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
  white-space: pre-wrap;
}

.hero-description,
.hero-meta,
.hero-score,
.hero-hint {
  margin-top: 14rpx;
}

.hero-score {
  color: var(--color-text-primary);
  font-weight: 700;
}

.hero-hint {
  color: var(--color-primary);
}

.question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.question-index {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.question-score {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.content-block-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.question-content {
  margin-top: 18rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.content-code {
  display: block;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #17324d;
  color: var(--color-code-text);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  font-family: "Courier New", monospace;
}

.option-code {
  margin-top: 8rpx;
}

.content-image-box {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-primary-soft);
}

.content-image {
  width: 100%;
  display: block;
}

.image-fallback {
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.text-answer-box {
  margin-top: 22rpx;
}

.text-answer-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 2rpx solid #d9e7ff;
  border-radius: 16rpx;
  background: var(--color-card-subtle);
  color: var(--color-text-primary);
  font-size: 27rpx;
  line-height: 1.6;
}

.code-answer-input {
  min-height: 112rpx;
  white-space: pre-wrap;
  font-family: "Courier New", monospace;
}

.option-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: var(--color-card-subtle);
  border: 2rpx solid transparent;
}

.option-card-selected {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
}

.option-card-correct {
  background: var(--color-success-soft);
  border-color: var(--color-success);
}

.option-card-wrong {
  background: var(--color-danger-soft);
  border-color: var(--color-danger);
}

.option-card-locked {
  pointer-events: none;
}

.option-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: var(--color-primary-soft);
  color: var(--color-text-primary);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  flex-shrink: 0;
}

.option-card-selected .option-badge {
  background: var(--color-primary);
  color: var(--color-text-inverse);
}

.option-card-correct .option-badge {
  background: #1f8f57;
  color: var(--color-text-inverse);
}

.option-card-wrong .option-badge {
  background: var(--color-danger);
  color: var(--color-text-inverse);
}

.option-body {
  flex: 1;
  min-width: 0;
}

.option-content {
  color: var(--color-text-primary);
}

.result-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--color-card-subtle);
  border: 2rpx solid #d9e7ff;
}

.result-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.result-correct {
  color: var(--color-success);
}

.result-wrong {
  color: var(--color-danger);
}

.result-answer,
.result-explanation {
  margin-top: 12rpx;
}

.explanation-list {
  margin-top: 12rpx;
}

.compact-state {
  padding: 44rpx 32rpx;
}

.submit-button {
  width: 100%;
}

.submit-button::after {
  border: none;
}

.footer-actions {
  display: flex;
  gap: 16rpx;
}

.footer-button {
  flex: 1;
}

.footer-button::after {
  border: none;
}
