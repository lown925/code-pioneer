@import "../../app.wxss";
.practice-page,.setup-stack,.question-stack { display:flex; flex-direction:column; gap:20rpx; }
.practice-hero { padding:28rpx; border-radius:28rpx; background:linear-gradient(135deg,#17406f,#2f6bff); color:#fff; }
.hero-eyebrow { font-size:18rpx; font-weight:700; letter-spacing:2rpx; opacity:.75; }
.hero-title { display:block; margin-top:12rpx; font-size:38rpx; font-weight:700; }
.hero-copy { display:block; margin-top:8rpx; color:rgba(255,255,255,.8); font-size:23rpx; line-height:1.6; }
.setup-card,.question-card,.result-card,.completed-card { padding:26rpx; }
.target-list,.option-list { display:flex; flex-direction:column; gap:12rpx; margin-top:20rpx; }
.target-option { display:flex; justify-content:space-between; align-items:center; padding:20rpx; border:2rpx solid #e5ebf4; border-radius:20rpx; }
.target-option-active { border-color:#2f6bff; background:#f1f5ff; }
.target-title,.target-meta { display:block; }.target-title { color:#17324d; font-size:27rpx; font-weight:700; }.target-meta { margin-top:5rpx; color:#7b8ba0; font-size:21rpx; }.target-check { color:#2f6bff; font-size:30rpx; }
.count-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:20rpx; }.count-option { padding:20rpx 8rpx; border-radius:18rpx; background:#f2f5f9; color:#64758b; text-align:center; }.count-option-active { background:#2f6bff; color:#fff; font-weight:700; }
.start-button { width:100%; box-sizing:border-box; }.button-disabled { opacity:.48; }.inline-error { color:#c84c35; font-size:22rpx; text-align:center; }.empty-note { margin-top:18rpx; color:#7b8ba0; }
.question-header { display:flex; justify-content:space-between; color:#526982; font-size:23rpx; }.question-course { font-weight:700; }.question-type { display:inline-flex; padding:7rpx 13rpx; border-radius:999rpx; background:#edf3ff; color:#2f6bff; font-size:19rpx; font-weight:700; }.question-content { display:block; margin-top:20rpx; color:#17324d; font-size:30rpx; font-weight:700; line-height:1.6; }
.option-card { display:flex; align-items:flex-start; gap:14rpx; padding:20rpx; border:2rpx solid #e5ebf4; border-radius:20rpx; }.option-selected { border-color:#2f6bff; }.option-correct { border-color:#2aaa73; background:#effaf5; }.option-wrong { border-color:#e56d50; background:#fff3ef; }.option-muted { opacity:.65; }.option-label { display:flex; align-items:center; justify-content:center; flex:0 0 44rpx; width:44rpx; height:44rpx; border-radius:14rpx; background:#edf2f8; font-weight:700; }.option-content { flex:1; color:#29415e; font-size:25rpx; line-height:1.55; }.saving-text { display:block; margin-top:14rpx; color:#2f6bff; font-size:21rpx; }
.result-card { border:2rpx solid #dfe8f4; }.result-correct { border-color:#bcebd6; }.result-wrong { border-color:#f1c9bd; }.result-title { display:block; font-size:29rpx; font-weight:700; }.result-correct .result-title { color:#16845d; }.result-wrong .result-title { color:#c64f35; }.result-answer,.result-explanation { display:block; margin-top:13rpx; color:#526982; font-size:23rpx; line-height:1.6; }.next-button { width:100%; margin-top:20rpx; box-sizing:border-box; }
.completed-card { text-align:center; }.completed-kicker { color:#2f6bff; font-size:22rpx; font-weight:700; }.completed-title { display:block; margin-top:10rpx; color:#17324d; font-size:34rpx; font-weight:700; }.score-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16rpx; margin-top:24rpx; }.score-grid view { padding:22rpx; border-radius:20rpx; background:#f5f8fc; }.score-value,.score-label { display:block; }.score-value { font-size:42rpx; font-weight:700; }.correct-value { color:#16845d; }.wrong-value { color:#c64f35; }.score-label { margin-top:5rpx; color:#7a8ba0; font-size:21rpx; }.completed-actions { display:flex; gap:14rpx; margin-top:24rpx; }.completed-actions view { flex:1; }.text-link { margin-top:22rpx; color:#60758f; font-size:23rpx; }
