@import "../../app.wxss";
.practice-page,.setup-stack,.question-stack { display:flex; flex-direction:column; gap:20rpx; }
.practice-hero { padding:28rpx; border-radius:28rpx; background:linear-gradient(135deg,#17406f,var(--color-primary)); color:var(--color-text-inverse); }
.hero-eyebrow { font-size:18rpx; font-weight:700; letter-spacing:2rpx; opacity:.75; }
.hero-title { display:block; margin-top:12rpx; font-size:38rpx; font-weight:700; }
.hero-copy { display:block; margin-top:8rpx; color:rgba(255,255,255,.8); font-size:23rpx; line-height:1.6; }
.setup-card,.question-card,.result-card,.completed-card { padding:26rpx; }
.target-list,.option-list { display:flex; flex-direction:column; gap:12rpx; margin-top:20rpx; }
.target-option { display:flex; justify-content:space-between; align-items:center; padding:20rpx; border:2rpx solid var(--color-border); border-radius:20rpx; }
.target-option-active { border-color:var(--color-primary); background:var(--color-primary-soft); }
.target-title,.target-meta { display:block; }.target-title { color:var(--color-text-primary); font-size:27rpx; font-weight:700; }.target-meta { margin-top:5rpx; color:var(--color-text-secondary); font-size:21rpx; }.target-check { color:var(--color-primary); font-size:30rpx; }
.count-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14rpx; margin-top:20rpx; }.count-option { padding:20rpx 8rpx; border-radius:18rpx; background:var(--color-bg-secondary); color:var(--color-text-secondary); text-align:center; }.count-option-active { background:var(--color-primary); color:var(--color-text-inverse); font-weight:700; }
.start-button { width:100%; box-sizing:border-box; }.button-disabled { opacity:.48; }.inline-error { color:var(--color-danger); font-size:22rpx; text-align:center; }.empty-note { margin-top:18rpx; color:var(--color-text-secondary); }
.question-header { display:flex; justify-content:space-between; color:var(--color-text-secondary); font-size:23rpx; }.question-course { font-weight:700; }.question-type { display:inline-flex; padding:7rpx 13rpx; border-radius:999rpx; background:var(--color-primary-subtle); color:var(--color-primary); font-size:19rpx; font-weight:700; }.question-content { display:block; margin-top:20rpx; color:var(--color-text-primary); font-size:30rpx; font-weight:700; line-height:1.6; }
.content-block-list { display:flex; flex-direction:column; gap:14rpx; margin-top:18rpx; }.stem-text { display:block; color:var(--color-text-primary); font-size:25rpx; line-height:1.65; white-space:pre-wrap; }.content-code { display:block; overflow-wrap:anywhere; padding:20rpx; border-radius:18rpx; background:#17324d; color:var(--color-code-text); font-family:"Courier New",monospace; font-size:24rpx; line-height:1.65; white-space:pre-wrap; }.content-image-box { overflow:hidden; border-radius:18rpx; background:var(--color-primary-soft); }.content-image { display:block; width:100%; }.image-fallback { padding:22rpx; color:var(--color-text-secondary); font-size:23rpx; text-align:center; }
.option-card { display:flex; align-items:flex-start; gap:14rpx; padding:20rpx; border:2rpx solid var(--color-border); border-radius:20rpx; }.option-selected { border-color:var(--color-primary); }.option-correct { border-color:var(--color-success); background:var(--color-success-soft); }.option-wrong { border-color:var(--color-danger); background:var(--color-danger-soft); }.option-muted { opacity:.65; }.option-label { display:flex; align-items:center; justify-content:center; flex:0 0 44rpx; width:44rpx; height:44rpx; border-radius:14rpx; background:var(--color-card-subtle); font-weight:700; }.option-content { flex:1; color:var(--color-text-primary); font-size:25rpx; line-height:1.55; }.saving-text { display:block; margin-top:14rpx; color:var(--color-primary); font-size:21rpx; }
.text-answer-box { display:flex; flex-direction:column; gap:16rpx; margin-top:20rpx; }.text-answer-input { width:100%; min-height:100rpx; box-sizing:border-box; padding:20rpx; border:2rpx solid var(--color-border); border-radius:18rpx; background:var(--color-card-subtle); color:var(--color-text-primary); font-size:26rpx; line-height:1.6; }.code-answer-input { min-height:112rpx; white-space:pre-wrap; font-family:"Courier New",monospace; }.text-submit-button { align-self:flex-end; min-width:200rpx; box-sizing:border-box; }
.result-card { border:2rpx solid var(--color-border); }.result-correct { border-color:#bcebd6; }.result-wrong { border-color:#f1c9bd; }.result-title { display:block; font-size:29rpx; font-weight:700; }.result-correct .result-title { color:var(--color-success); }.result-wrong .result-title { color:var(--color-danger); }.result-answer,.result-explanation { display:block; margin-top:13rpx; color:var(--color-text-secondary); font-size:23rpx; line-height:1.6; }.next-button { width:100%; margin-top:20rpx; box-sizing:border-box; }
.completed-card { text-align:center; }.completed-kicker { color:var(--color-primary); font-size:22rpx; font-weight:700; }.completed-title { display:block; margin-top:10rpx; color:var(--color-text-primary); font-size:34rpx; font-weight:700; }.score-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16rpx; margin-top:24rpx; }.score-grid view { padding:22rpx; border-radius:20rpx; background:var(--color-card-subtle); }.score-value,.score-label { display:block; }.score-value { font-size:42rpx; font-weight:700; }.correct-value { color:var(--color-success); }.wrong-value { color:var(--color-danger); }.score-label { margin-top:5rpx; color:var(--color-text-secondary); font-size:21rpx; }.completed-actions { display:flex; gap:14rpx; margin-top:24rpx; }.completed-actions view { flex:1; }.text-link { margin-top:22rpx; color:var(--color-text-secondary); font-size:23rpx; }
