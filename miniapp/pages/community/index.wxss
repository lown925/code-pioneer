@import "../../app.wxss";

.community-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 160rpx;
}

.hero-card,
.category-card,
.feed-card,
.loading-more {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.84);
}

.hero-action-row {
  margin-top: 24rpx;
}

.hero-action {
  min-height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
}

.category-row {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 20rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.category-chip-active {
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feed-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feed-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e7efff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.author-avatar-image {
  width: 100%;
  height: 100%;
}

.author-avatar-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #2f6bff;
}

.author-meta {
  flex: 1;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #17324d;
}

.author-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e84a3;
}

.category-tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 600;
}

.feed-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #17324d;
}

.feed-preview {
  display: -webkit-box;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f7596;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.image-preview-row {
  display: flex;
  gap: 12rpx;
}

.image-preview {
  width: 180rpx;
  height: 136rpx;
  border-radius: 18rpx;
  background: #eef4ff;
}

.feed-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.feed-stat {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f6f9fd;
}

.feed-stat-label,
.feed-stat-value {
  font-size: 22rpx;
  color: #6e84a3;
}

.feed-stat-value {
  color: #17324d;
  font-weight: 700;
}

.loading-more {
  display: flex;
  justify-content: center;
  text-align: center;
}

.loading-more-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.state-button {
  min-height: 72rpx;
}

.compose-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-width: 176rpx;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(23, 50, 77, 0.2);
}
