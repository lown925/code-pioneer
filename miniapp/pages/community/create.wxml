<view class="create-page">
  <view class="custom-nav">
    <view class="nav-back" bindtap="handleBack">返回</view>
    <text class="nav-title">发布帖子</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="page-shell create-shell">
    <view wx:if="{{isLoadingCategories}}" class="section-card state-box">
      <text class="state-title">分区加载中</text>
      <text class="state-text">正在准备可用分区，请稍候。</text>
    </view>

    <view wx:elif="{{loadErrorMessage}}" class="section-card state-box">
      <text class="state-title">加载失败</text>
      <text class="state-text">{{loadErrorMessage}}</text>
      <view class="primary-button state-button" bindtap="handleRetry">重新加载</view>
    </view>

    <block wx:else>
      <view class="section-card form-card">
        <text class="section-title">选择分区</text>
        <text class="section-subtitle">请选择本条帖子最匹配的讨论分区。</text>

        <view class="category-row">
          <view
            wx:for="{{categories}}"
            wx:key="key"
            class="category-chip {{selectedCategoryKey === item.key ? 'category-chip-active' : ''}}"
            data-category-key="{{item.key}}"
            bindtap="handleCategoryTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="section-card form-card">
        <view class="field-head">
          <text class="section-title">标题</text>
          <text class="field-count">{{titleCountText}}</text>
        </view>
        <input
          class="text-input"
          maxlength="80"
          placeholder="用一句清楚的话概括你要讨论的问题或经验"
          value="{{title}}"
          bindinput="handleTitleInput"
        />
      </view>

      <view class="section-card form-card">
        <view class="field-head">
          <text class="section-title">正文</text>
          <text class="field-count">{{contentCountText}}</text>
        </view>
        <textarea
          class="textarea-input"
          maxlength="4000"
          placeholder="补充上下文、问题现象、你的思路或想法。本轮仅支持纯文本。"
          value="{{content}}"
          bindinput="handleContentInput"
        />
      </view>

      <view class="section-card form-card">
        <view class="field-head">
          <text class="section-title">配图</text>
          <text class="field-count">{{imageCountText}}</text>
        </view>
        <text class="section-subtitle">支持 JPG、PNG、WebP、GIF，最多 6 张，单张不超过 5 MB。</text>

        <view class="image-toolbar">
          <view
            class="ghost-button image-picker-button {{isUploadingImages ? 'image-picker-button-disabled' : ''}}"
            bindtap="handleChooseImages"
          >
            {{isUploadingImages ? '上传中...' : '选择图片'}}
          </view>
        </view>

        <view wx:if="{{images.length > 0}}" class="image-grid">
          <view wx:for="{{images}}" wx:key="objectKey" class="image-card">
            <image
              class="image-card-preview"
              src="{{item.localPath || item.url}}"
              mode="aspectFill"
              data-index="{{index}}"
              bindtap="handlePreviewImage"
            />
            <view class="image-card-footer">
              <text class="image-card-label">第 {{index + 1}} 张</text>
              <view class="image-card-remove" data-index="{{index}}" bindtap="handleRemoveImage">
                删除
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="section-card note-card">
        <text class="section-title">当前限制</text>
        <text class="section-subtitle">
          当前支持正文加图片发帖。评论仅支持纯文本，暂不支持评论图片和帖子编辑。
        </text>
      </view>

      <view class="submit-bar">
        <view
          class="primary-button submit-button {{isSubmitting ? 'submit-button-disabled' : ''}}"
          bindtap="handleSubmit"
        >
          {{isSubmitting ? '正在发布...' : isUploadingImages ? '图片上传中...' : '立即发布'}}
        </view>
      </view>
    </block>
  </view>
</view>
