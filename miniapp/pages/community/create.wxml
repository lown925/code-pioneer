<view class="create-page">
  <view class="custom-nav">
    <view class="nav-back" bindtap="handleBack">返回</view>
    <text class="nav-title">发布帖子</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="page-shell create-shell">
    <view wx:if="{{isLoadingCategories}}" class="section-card state-box">
      <text class="state-title">正在准备编辑器</text>
      <text class="state-text">加载社区分区，请稍候。</text>
    </view>

    <view wx:elif="{{loadErrorMessage}}" class="section-card state-box">
      <text class="state-title">加载失败</text>
      <text class="state-text">{{loadErrorMessage}}</text>
      <view class="primary-button state-button" bindtap="handleRetry">重新加载</view>
    </view>

    <block wx:else>
      <view class="section-card form-card compact-card">
        <view class="category-row">
          <view
            wx:for="{{categories}}"
            wx:key="key"
            class="category-chip {{selectedCategoryKey === item.key ? 'category-chip-active' : ''}}"
            data-category-key="{{item.key}}"
            bindtap="handleCategoryTap"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="section-card form-card">
        <view class="field-head">
          <text class="field-label">帖子标题</text>
          <text class="field-count">{{titleCountText}}</text>
        </view>
        <input
          class="title-input"
          maxlength="80"
          placeholder="清楚概括你要讨论的问题或经验"
          value="{{title}}"
          bindinput="handleTitleInput"
        />
      </view>

      <view class="editor-head">
        <view>
          <text class="editor-title">内容编辑器</text>
          <text class="editor-subtitle">文字、图片和代码可自由排序</text>
        </view>
        <view class="editor-summary">
          <text>{{contentCountText}}</text>
          <text>{{imageCountText}}</text>
        </view>
      </view>

      <view wx:for="{{editorBlocks}}" wx:key="id" class="editor-block-wrap">
        <view class="section-card editor-block {{item.type === 'CODE' ? 'editor-block-code' : ''}}">
          <view class="block-head">
            <text class="block-type">{{item.type === 'TEXT' ? '文字' : item.type === 'CODE' ? '代码' : '图片'}}</text>
            <view class="block-actions">
              <view class="block-action {{index === 0 ? 'block-action-disabled' : ''}}" data-block-id="{{item.id}}" bindtap="handleMoveBlockUp">上移</view>
              <view class="block-action {{index === editorBlocks.length - 1 ? 'block-action-disabled' : ''}}" data-block-id="{{item.id}}" bindtap="handleMoveBlockDown">下移</view>
              <view class="block-action block-delete" data-block-id="{{item.id}}" bindtap="handleRemoveBlock">删除</view>
            </view>
          </view>

          <textarea
            wx:if="{{item.type === 'TEXT'}}"
            class="block-textarea"
            maxlength="20000"
            auto-height
            placeholder="输入正文内容，可粘贴多行文字"
            value="{{item.text}}"
            data-block-id="{{item.id}}"
            bindinput="handleBlockTextInput"
          />

          <view wx:elif="{{item.type === 'CODE'}}" class="code-editor">
            <input
              class="language-input"
              maxlength="40"
              placeholder="语言，可选，例如 JavaScript"
              value="{{item.language}}"
              data-block-id="{{item.id}}"
              bindinput="handleBlockLanguageInput"
            />
            <textarea
              class="code-textarea"
              maxlength="20000"
              placeholder="在这里输入或粘贴代码，换行和缩进会被保留"
              value="{{item.code}}"
              data-block-id="{{item.id}}"
              bindinput="handleBlockCodeInput"
            />
          </view>

          <view wx:else class="image-editor">
            <image class="image-preview" src="{{item.localPath}}" mode="widthFix" data-block-id="{{item.id}}" bindtap="handlePreviewImage" />
            <view wx:if="{{item.isUploading}}" class="image-status image-status-loading">正在上传图片...</view>
            <view wx:elif="{{item.uploadError}}" class="image-status image-status-error" data-block-id="{{item.id}}" bindtap="handleRetryImageUpload">
              {{item.uploadError}}
            </view>
            <view wx:else class="image-status image-status-success">已上传，可继续调整位置</view>
          </view>
        </view>

        <view class="insert-toolbar">
          <view class="insert-line"></view>
          <view class="insert-actions">
            <view class="insert-button" data-block-id="{{item.id}}" bindtap="handleAddTextBlock">+ 文字</view>
            <view class="insert-button" data-block-id="{{item.id}}" bindtap="handleAddImageBlock">+ 图片</view>
            <view class="insert-button" data-block-id="{{item.id}}" bindtap="handleAddCodeBlock">+ 代码</view>
          </view>
          <view class="insert-line"></view>
        </view>
      </view>

      <view wx:if="{{editorBlocks.length === 0}}" class="section-card empty-editor">
        <text class="empty-editor-title">从一个内容块开始</text>
        <text class="empty-editor-copy">按你希望读者看到的顺序添加内容。</text>
        <view class="insert-actions empty-insert-actions">
          <view class="insert-button" bindtap="handleAddTextBlock">+ 文字</view>
          <view class="insert-button" bindtap="handleAddImageBlock">+ 图片</view>
          <view class="insert-button" bindtap="handleAddCodeBlock">+ 代码</view>
        </view>
      </view>

      <view class="editor-tip">
        <text>图片可分多次添加，不限制帖子图片总数；单张仍需小于 5 MB。</text>
      </view>

      <view class="submit-bar">
        <view
          class="primary-button submit-button {{isSubmitting || isUploadingImages ? 'submit-button-disabled' : ''}}"
          bindtap="handleSubmit"
        >
          {{isSubmitting ? '正在发布...' : isUploadingImages ? '图片上传中...' : '发布帖子'}}
        </view>
      </view>
    </block>
  </view>
</view>
