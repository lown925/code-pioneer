<view class="page-shell detail-page">
  <view wx:if="{{state === 'loading' && !post}}" class="section-card state-box">
    <text class="state-title">帖子加载中</text>
    <text class="state-text">正在获取帖子详情和评论，请稍候。</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="section-card state-box">
    <text class="state-title">加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="primary-button state-button" bindtap="handleRetry">重新加载</view>
  </view>

  <block wx:elif="{{post}}">
    <view class="section-card detail-card">
      <view class="detail-header detail-header-clickable" data-user-id="{{post.author.userId}}" bindtap="handleOpenAuthorProfile">
        <view class="author-avatar">
          <image
            wx:if="{{post.author.avatarUrl}}"
            class="author-avatar-image"
            src="{{post.author.avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else class="author-avatar-text">{{post.authorInitial}}</text>
        </view>

        <view class="author-meta">
          <text class="author-name">{{post.authorName}}</text>
          <text class="author-time">{{post.createdAtText}}</text>
        </view>

        <view class="category-tag">{{post.category.name}}</view>
      </view>

      <text class="detail-title">{{post.title}}</text>
      <text class="detail-content">{{post.content}}</text>

      <view wx:if="{{post.images.length > 0}}" class="detail-image-list">
        <image
          wx:for="{{post.images}}"
          wx:key="imageId"
          class="detail-image"
          src="{{item.url}}"
          mode="widthFix"
          data-url="{{item.url}}"
          bindtap="handlePreviewImage"
        />
      </view>
    </view>

    <view class="section-card info-card">
      <view class="info-row">
        <text class="info-label">收藏</text>
        <text class="info-value">{{post.favoriteCountText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">评论</text>
        <text class="info-value">{{post.commentCountText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">浏览</text>
        <text class="info-value">{{post.viewCountText}}</text>
      </view>
    </view>

    <view class="section-card comment-card">
      <view class="comment-head">
        <view>
          <text class="section-title">评论 {{commentCountText}}</text>
          <text class="section-subtitle">仅支持纯文本评论，按发布时间正序显示。</text>
        </view>
      </view>

      <view wx:if="{{isCommentsLoading && comments.length === 0}}" class="state-box compact-state">
        <text class="state-text">正在加载评论，请稍候。</text>
      </view>

      <view wx:elif="{{commentsErrorMessage}}" class="state-box compact-state">
        <text class="state-text">{{commentsErrorMessage}}</text>
        <view class="ghost-button comment-retry-button" bindtap="handleRetry">重新加载</view>
      </view>

      <view wx:elif="{{comments.length === 0}}" class="state-box compact-state">
        <text class="state-text">还没有评论，欢迎发布第一条评论。</text>
      </view>

      <view wx:else class="comment-list">
        <view wx:for="{{comments}}" wx:key="commentId" class="comment-item">
          <view class="comment-avatar">
            <image
              wx:if="{{item.author.avatarUrl}}"
              class="comment-avatar-image"
              src="{{item.author.avatarUrl}}"
              mode="aspectFill"
            />
            <text wx:else class="comment-avatar-text">{{item.authorInitial}}</text>
          </view>

          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-author">{{item.authorName}}</text>
              <text wx:if="{{item.isAuthor}}" class="comment-self-tag">我</text>
              <text class="comment-time">{{item.createdAtText}}</text>
            </view>
            <text class="comment-content">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{post}}" class="action-bar">
    <view class="comment-input-shell">
      <textarea
        class="comment-input"
        maxlength="1000"
        placeholder="写下你的评论，本轮仅支持纯文本。"
        value="{{commentDraft}}"
        bindinput="handleCommentInput"
        auto-height
        cursor-spacing="24"
      />
      <view class="comment-submit-row">
        <text class="comment-draft-count">{{commentDraft.length}} / 1000</text>
        <view
          class="primary-button comment-submit-button {{isCommentSubmitting ? 'action-button-disabled' : ''}}"
          bindtap="handleCommentSubmit"
        >
          {{isCommentSubmitting ? '发布中...' : '发布评论'}}
        </view>
      </view>
    </view>

    <view class="action-row">
      <view
        class="ghost-button action-button {{isFavoriteSubmitting ? 'action-button-disabled' : ''}}"
        bindtap="handleFavoriteToggle"
      >
        {{post.viewerHasFavorited ? '取消收藏' : '收藏帖子'}}
      </view>
      <view
        wx:if="{{post.isAuthor}}"
        class="danger-button action-button {{isDeleting ? 'action-button-disabled' : ''}}"
        bindtap="handleDelete"
      >
        {{isDeleting ? '删除中...' : '删除帖子'}}
      </view>
    </view>
  </view>
</view>
