@import "../../app.wxss";

.create-page {
  min-height: 100vh;
  background: #f4f8fc;
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx 20rpx;
  background: #f4f8fc;
}

.nav-back,
.nav-placeholder {
  width: 120rpx;
  font-size: 26rpx;
  color: #2f6bff;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #17324d;
}

.create-shell {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 8rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.form-card,
.note-card {
  padding: 28rpx;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 24rpx;
  font-weight: 600;
}

.category-chip-active {
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
}

.field-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.field-count {
  font-size: 22rpx;
  color: #6e84a3;
}

.text-input,
.textarea-input {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f6f9fd;
  color: #17324d;
  font-size: 28rpx;
}

.text-input {
  min-height: 92rpx;
  padding: 0 24rpx;
}

.textarea-input {
  min-height: 320rpx;
  padding: 24rpx;
  line-height: 1.7;
}

.image-toolbar {
  margin-top: 20rpx;
}

.image-picker-button {
  min-height: 72rpx;
}

.image-picker-button-disabled {
  opacity: 0.72;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.image-card {
  overflow: hidden;
  border-radius: 22rpx;
  background: #f6f9fd;
}

.image-card-preview {
  width: 100%;
  height: 220rpx;
  background: #e9f0fb;
}

.image-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 18rpx 18rpx;
}

.image-card-label {
  font-size: 22rpx;
  color: #6e84a3;
}

.image-card-remove {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6bff;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(244, 248, 252, 0.96);
  box-sizing: border-box;
}

.submit-button {
  width: 100%;
  min-height: 84rpx;
}

.submit-button-disabled {
  opacity: 0.72;
}

.state-button {
  min-height: 72rpx;
}
