@import "../../app.wxss";

.play-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.hero-card,
.status-card,
.question-nav-card,
.question-card,
.footer-card,
.state-box {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy,
.state-text,
.code-fill-hint,
.inline-error-text {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.75;
}

.hero-copy {
  color: rgba(255, 255, 255, 0.84);
}

.state-title,
.section-title,
.question-number {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #17324d;
}

.state-text {
  color: #5f7596;
}

.state-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.status-card {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.progress-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
}

.progress-heading,
.progress-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-total,
.progress-status {
  font-size: 22rpx;
  color: #6e84a3;
}

.progress-player {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.progress-label,
.progress-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #17324d;
}

.progress-track {
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf2f8;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  transition: width 180ms ease;
}

.progress-fill-self {
  background: #2f6bff;
}

.progress-fill-opponent {
  background: #ef9f4a;
}

.status-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f6f9fd;
}

.status-label {
  display: block;
  font-size: 22rpx;
  color: #6e84a3;
}

.status-value {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #17324d;
}

.status-item-countdown {
  background: #eef5ff;
}

.countdown-value {
  color: #2f6bff;
}

.question-nav-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.nav-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.nav-chip-current {
  background: #17324d;
  color: #ffffff;
}

.nav-chip-answered {
  background: #e8f6ee;
  color: #177245;
}

.nav-chip-saving {
  background: #eef5ff;
  color: #2f6bff;
}

.nav-chip-error {
  background: #fff3f3;
  color: #c24343;
}

.nav-chip-pending {
  background: #f4f6f8;
  color: #6e84a3;
}

.question-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.question-type,
.question-difficulty {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f5fa;
  font-size: 22rpx;
  color: #5f7596;
}

.sync-banner {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
}

.sync-banner-idle,
.sync-banner-saved {
  background: #f6f9fd;
}

.sync-banner-saving {
  background: #eef5ff;
}

.sync-banner-error {
  background: #fff3f3;
}

.sync-banner-text {
  font-size: 24rpx;
  color: #17324d;
}

.content-block-list,
.option-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.content-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #17324d;
  word-break: break-word;
}

.content-code {
  display: block;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #0f1720;
  color: #f8fbff;
  font-size: 24rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
  font-family: "Cascadia Code", "Fira Code", monospace;
}

.content-image-box {
  overflow: hidden;
  border-radius: 18rpx;
  background: #f6f9fd;
}

.content-image {
  display: block;
  width: 100%;
}

.image-fallback {
  padding: 28rpx 20rpx;
  font-size: 24rpx;
  color: #6e84a3;
  text-align: center;
}

.option-card {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 2rpx solid rgba(23, 50, 77, 0.08);
}

.option-card-selected {
  border-color: #2f6bff;
  background: #eef5ff;
}

.option-card-locked {
  opacity: 0.76;
}

.option-label {
  flex: 0 0 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #17324d;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.code-fill-box {
  margin-top: 22rpx;
}

.code-fill-input {
  width: 100%;
  min-height: 260rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #0f1720;
  color: #f8fbff;
  font-size: 24rpx;
  line-height: 1.8;
  font-family: "Cascadia Code", "Fira Code", monospace;
}

.code-fill-hint {
  color: #6e84a3;
}

.inline-error-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff6f6;
}

.inline-error-text {
  margin-top: 0;
  color: #c24343;
}

.retry-sync-button {
  margin-top: 14rpx;
  min-height: 64rpx;
}

.footer-card {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.footer-primary-row,
.footer-secondary-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.footer-secondary-row {
  margin-top: 18rpx;
}

.nav-button {
  flex: 1;
  min-height: 88rpx;
}

.submit-battle-button {
  min-width: 220rpx;
  min-height: 72rpx;
}

.secondary-spacer {
  flex: 1;
}

.forfeit-button {
  min-width: 156rpx;
  min-height: 64rpx;
  border: 1rpx solid rgba(194, 67, 67, 0.18);
  background: #fff8f8;
  color: #b14a4a;
}

.action-button-disabled {
  opacity: 0.52;
  pointer-events: none;
}

.state-text-warning {
  color: #c24343;
}

@media (max-width: 420px) {
  .status-card {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .question-nav-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
