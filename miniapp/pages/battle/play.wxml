<view class="page-shell play-page">
  <view class="section-card hero-card">
    <text class="hero-eyebrow">Battle 答题</text>
    <text class="hero-title">{{titleText}}</text>
    <text class="hero-copy">{{descriptionText}}</text>
  </view>

  <view wx:if="{{state === 'LOADING'}}" class="section-card state-box">
    <text class="state-title">正在加载题目</text>
    <text class="state-text">系统正在同步题目快照、已答状态和剩余时间。</text>
  </view>

  <view wx:elif="{{state === 'ERROR'}}" class="section-card state-box">
    <text class="state-title">题目加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="state-actions">
      <view class="primary-button action-button" bindtap="handleRetry">重新获取题目</view>
      <view class="ghost-button action-button" bindtap="handleBackRoom">返回房间</view>
    </view>
  </view>

  <block wx:else>
    <view class="section-card status-card">
      <view class="status-item">
        <text class="status-label">剩余时间</text>
        <text class="status-value">{{remainingTimeText}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">当前题号</text>
        <text class="status-value">{{questionCountText}}</text>
      </view>
      <view wx:if="{{state === 'COUNTDOWN'}}" class="status-item status-item-countdown">
        <text class="status-label">开始倒计时</text>
        <text class="status-value countdown-value">{{countdownText || '3'}}</text>
      </view>
    </view>

    <view wx:if="{{questions.length > 0}}" class="section-card question-nav-card">
      <text class="section-title">题号导航</text>
      <view class="question-nav-grid">
        <view
          wx:for="{{questions}}"
          wx:key="battleQuestionId"
          class="nav-chip nav-chip-{{item.navStatus}}"
          data-index="{{index}}"
          bindtap="handleSelectQuestion"
        >
          {{item.navLabel}}
        </view>
      </view>
    </view>

    <view wx:if="{{questions.length > 0}}" class="section-card question-card">
      <block wx:for="{{questions}}" wx:key="battleQuestionId" wx:for-item="question">
        <block wx:if="{{index === currentQuestionIndex}}">
          <view class="question-header">
            <text class="question-number">{{question.questionNumberText}}</text>
            <view class="question-meta">
              <text class="question-type">{{question.questionTypeText}}</text>
              <text class="question-difficulty">{{question.difficultyText}}</text>
            </view>
          </view>

          <view class="sync-banner sync-banner-{{question.syncState}}">
            <text class="sync-banner-text">{{question.syncStatusText}}</text>
          </view>

          <view class="content-block-list">
            <block wx:for="{{question.stem}}" wx:key="blockKey" wx:for-item="block">
              <text wx:if="{{block.type === 'TEXT'}}" class="content-text">{{block.text}}</text>
              <text wx:elif="{{block.type === 'CODE'}}" class="content-code">{{block.code}}</text>
              <view wx:elif="{{block.type === 'IMAGE'}}" class="content-image-box">
                <image
                  wx:if="{{!block.imageFailed}}"
                  class="content-image"
                  src="{{block.url}}"
                  mode="widthFix"
                  data-question-id="{{question.battleQuestionId}}"
                  data-block-key="{{block.blockKey}}"
                  binderror="handleImageError"
                />
                <view wx:else class="image-fallback">{{block.altText}}</view>
              </view>
            </block>
          </view>

          <view wx:if="{{question.questionType === 'SINGLE_CHOICE'}}" class="option-list">
            <view
              wx:for="{{question.options}}"
              wx:key="optionId"
              wx:for-item="option"
              class="option-card {{option.isSelected ? 'option-card-selected' : ''}} {{state !== 'PLAYING' || isBattleActionPending ? 'option-card-locked' : ''}}"
              data-question-id="{{question.battleQuestionId}}"
              data-option-id="{{option.optionId}}"
              bindtap="handleOptionSelect"
            >
              <view class="option-label">{{option.optionLabel}}</view>
              <view class="option-body">
                <block wx:for="{{option.blocks}}" wx:key="blockKey" wx:for-item="block">
                  <text wx:if="{{block.type === 'TEXT'}}" class="content-text">{{block.text}}</text>
                  <text wx:elif="{{block.type === 'CODE'}}" class="content-code">{{block.code}}</text>
                  <view wx:elif="{{block.type === 'IMAGE'}}" class="content-image-box">
                    <image
                      wx:if="{{!block.imageFailed}}"
                      class="content-image"
                      src="{{block.url}}"
                      mode="widthFix"
                      data-question-id="{{question.battleQuestionId}}"
                      data-option-id="{{option.optionId}}"
                      data-block-key="{{block.blockKey}}"
                      binderror="handleImageError"
                    />
                    <view wx:else class="image-fallback">{{block.altText}}</view>
                  </view>
                </block>
              </view>
            </view>
          </view>

          <view wx:elif="{{question.questionType === 'CODE_FILL'}}" class="code-fill-box">
            <textarea
              class="code-fill-input"
              value="{{question.draftValue}}"
              maxlength="4000"
              auto-height
              disabled="{{state !== 'PLAYING' || isBattleActionPending}}"
              placeholder="请输入你的代码填空答案"
              data-question-id="{{question.battleQuestionId}}"
              bindinput="handleCodeInput"
            />
            <text class="code-fill-hint">
              输入后会自动暂存。页面重新进入时，会从服务端恢复最近一次成功保存的内容。
            </text>
          </view>

          <view wx:if="{{question.syncErrorMessage}}" class="inline-error-box">
            <text class="inline-error-text">{{question.syncErrorMessage}}</text>
            <view
              class="ghost-button retry-sync-button"
              data-question-id="{{question.battleQuestionId}}"
              bindtap="handleRetryQuestionSync"
            >
              重试同步
            </view>
          </view>
        </block>
      </block>
    </view>

    <view wx:elif="{{state === 'COUNTDOWN'}}" class="section-card state-box">
      <text class="state-title">倒计时未结束</text>
      <text class="state-text">题目已经准备完成，到达 startedAt 后会自动进入可作答状态。</text>
    </view>

    <view wx:elif="{{state === 'WAITING_SETTLEMENT'}}" class="section-card state-box">
      <text class="state-title">等待结算中</text>
      <text class="state-text">{{isTrainingMode ? '当前已停止作答，系统正在整理单人训练结果。' : '当前已停止作答，系统正在等待对手或处理本场结算。'}}</text>
      <text wx:if="{{errorMessage}}" class="state-text state-text-warning">{{errorMessage}}</text>
    </view>

    <view wx:elif="{{state === 'COMPLETED'}}" class="section-card state-box">
      <text class="state-title">本场对战已结束</text>
      <text class="state-text">当前对局已经完成，正在跳转结果页。</text>
    </view>

    <view class="section-card footer-card">
      <view class="footer-primary-row">
        <view
          class="ghost-button nav-button {{currentQuestionIndex <= 0 ? 'action-button-disabled' : ''}}"
          bindtap="handlePrevQuestion"
        >
          上一题
        </view>
        <view
          class="ghost-button nav-button {{currentQuestionIndex >= questions.length - 1 ? 'action-button-disabled' : ''}}"
          bindtap="handleNextQuestion"
        >
          下一题
        </view>
      </view>

      <view class="footer-secondary-row">
        <view
          wx:if="{{state === 'PLAYING' || state === 'COUNTDOWN'}}"
          class="primary-button submit-battle-button {{isBattleActionPending ? 'action-button-disabled' : ''}}"
          bindtap="handleSubmitBattle"
        >
          {{submitBattleButtonText}}
        </view>
        <view class="secondary-spacer"></view>
        <view
          wx:if="{{!isTrainingMode && (state === 'PLAYING' || state === 'COUNTDOWN')}}"
          class="ghost-button forfeit-button {{isBattleActionPending ? 'action-button-disabled' : ''}}"
          bindtap="handleForfeitBattle"
        >
          {{forfeitButtonText}}
        </view>
      </view>
    </view>
  </block>
</view>
