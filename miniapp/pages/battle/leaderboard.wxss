@import "../../app.wxss";

.leaderboard-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.summary-card,
.leaderboard-card,
.loading-more,
.footer-error {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.leaderboard-scope {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  padding: 6rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  background: var(--color-card-subtle);
}

.scope-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  border-radius: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.scope-option-active {
  background: var(--color-card);
  color: var(--color-text-primary);
  box-shadow: 0 6rpx 16rpx rgba(23, 50, 77, 0.1);
}

.summary-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.summary-label,
.winrate-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.summary-value,
.winrate-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.summary-copy {
  grid-column: 1 / -1;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.leaderboard-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.leaderboard-card-current {
  border: 2rpx solid var(--color-primary);
  box-shadow: 0 18rpx 40rpx rgba(47, 107, 255, 0.12);
}

.leaderboard-top,
.leaderboard-body,
.leaderboard-rank {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.leaderboard-top {
  align-items: flex-start;
}

.leaderboard-rank {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.rank-badge,
.current-user-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.rank-badge {
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

.current-user-badge {
  background: #17324d;
  color: var(--color-text-inverse);
}

.rank-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.avatar-frame {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-primary-subtle);
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-image {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.player-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--color-text-primary);
}

.player-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.leaderboard-card-stars {
  margin-top: 8rpx;
  font-size: 25rpx;
}

.winrate-box {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
  text-align: center;
}

.loading-more,
.footer-error {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  text-align: center;
}

.loading-more-text,
.footer-error-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.retry-button {
  min-height: 72rpx;
}

@media (max-width: 420px) {
  .summary-card {
    grid-template-columns: minmax(0, 1fr);
  }

  .summary-copy {
    grid-column: auto;
  }

  .leaderboard-body {
    align-items: flex-start;
  }
}
