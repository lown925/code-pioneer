@import "../../app.wxss";

.history-detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.summary-card,
.opponent-card,
.stats-card,
.rating-card,
.question-card,
.footer-card {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.summary-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.summary-mode,
.summary-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-card-subtle);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.summary-grid,
.stats-grid,
.rating-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.summary-item,
.stat-item,
.rating-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
}

.summary-label,
.stat-label,
.rating-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.summary-value,
.stat-value,
.rating-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.summary-end-reason {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.score-card {
  padding: 28rpx;
  text-align: center;
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-value {
  display: block;
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.opponent-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.opponent-avatar-frame {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-primary-subtle);
  flex-shrink: 0;
}

.opponent-avatar-image,
.opponent-avatar-fallback {
  width: 100%;
  height: 100%;
}

.opponent-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.opponent-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.opponent-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.opponent-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 18rpx;
}

.result-badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.result-badge-win,
.result-pill-correct,
.option-badge-correct {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.result-badge-loss,
.result-pill-wrong {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.result-badge-draw,
.result-pill-unanswered,
.option-badge-my {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.question-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.question-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.question-number {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.question-type,
.question-difficulty,
.result-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.question-type {
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

.question-difficulty {
  background: var(--color-card-subtle);
  color: var(--color-text-secondary);
}

.question-score-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
}

.score-delta-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-delta-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.content-block-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-primary);
  white-space: pre-wrap;
}

.content-code {
  display: block;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-code-bg);
  color: var(--color-code-text);
  font-size: 24rpx;
  line-height: 1.8;
  font-family: "Courier New", Consolas, monospace;
  white-space: pre-wrap;
}

.content-image-box {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.content-image {
  width: 100%;
  border-radius: 18rpx;
  background: var(--color-card-subtle);
}

.image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-card-subtle);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: center;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--color-card-elevated);
  border: 2rpx solid transparent;
}

.option-card-correct {
  border-color: var(--color-success);
}

.option-card-my {
  border-color: var(--color-primary);
}

.option-top {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.option-label {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-card);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.option-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.option-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.option-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-subcard {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
}

.section-subtitle {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.answer-summary,
.answer-meta,
.relation-label,
.relation-value {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
}

.answer-meta,
.relation-label {
  color: var(--color-text-secondary);
}

.relation-row {
  display: flex;
  gap: 8rpx;
}

.small-button {
  min-height: 64rpx;
  padding: 0 22rpx;
  align-self: flex-start;
}

.footer-actions,
.state-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-button {
  min-height: 76rpx;
}

@media (max-width: 420px) {
  .summary-top,
  .question-header,
  .option-top {
    flex-direction: column;
  }

  .summary-meta,
  .question-meta,
  .option-badges {
    justify-content: flex-start;
  }

  .summary-grid,
  .stats-grid,
  .rating-grid,
  .score-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
