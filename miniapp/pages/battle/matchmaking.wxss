@import "../../app.wxss";

.matchmaking-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.rating-card,
.skill-card,
.status-card {
  padding: 28rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.skill-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(47, 107, 255, 0.1);
  border-radius: 22rpx;
  background: #f6f9fd;
}

.skill-option-selected {
  border-color: #2f6bff;
  background: #eef4ff;
}

.skill-option-locked {
  opacity: 0.76;
}

.skill-name,
.skill-status {
  display: block;
}

.skill-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #17324d;
}

.skill-status {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e84a3;
}

.skill-check,
.locked-skill {
  color: #2f6bff;
  font-weight: 700;
}

.skill-check {
  font-size: 24rpx;
}

.locked-skill {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.timer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.rating-card {
  display: block;
}

.rating-item,
.timer-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f9fd;
}

.rating-label,
.timer-label,
.matched-label {
  display: block;
  font-size: 22rpx;
  color: #6e84a3;
}

.rating-value,
.timer-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #17324d;
}

.waiting-count-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.waiting-count-unit {
  color: #6e84a3;
  font-size: 22rpx;
  font-weight: 600;
}

.timer-grid {
  margin-top: 24rpx;
}

.matched-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #eef4ff;
}

.matched-value {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #17324d;
  word-break: break-all;
}

.error-copy {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #c24343;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-button {
  min-height: 76rpx;
}

.disabled-button {
  opacity: 0.78;
}

@media (max-width: 420px) {
  .timer-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
