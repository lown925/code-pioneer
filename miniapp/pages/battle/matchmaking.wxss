@import "../../app.wxss";

.matchmaking-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.rating-card,
.status-card {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.rating-card,
.timer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.rating-item,
.timer-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f9fd;
}

.rating-label,
.timer-label,
.matched-label {
  display: block;
  font-size: 22rpx;
  color: #6e84a3;
}

.rating-value,
.timer-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #17324d;
}

.timer-grid {
  margin-top: 24rpx;
}

.matched-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #eef4ff;
}

.matched-value {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #17324d;
  word-break: break-all;
}

.error-copy {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #c24343;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-button {
  min-height: 76rpx;
}

.disabled-button {
  opacity: 0.78;
}

@media (max-width: 420px) {
  .rating-card,
  .timer-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
