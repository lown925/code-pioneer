@import "../../app.wxss";

.matchmaking-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.skill-card,
.status-card {
  padding: 28rpx;
}

.skill-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.skill-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(47, 107, 255, 0.1);
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.skill-option-selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.skill-option-locked {
  opacity: 0.76;
}

.skill-name,
.skill-status {
  display: block;
}

.skill-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.skill-status {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.skill-star-rating {
  font-size: 22rpx;
}

.skill-check,
.locked-skill {
  color: var(--color-primary);
  font-weight: 700;
}

.skill-check {
  font-size: 24rpx;
}

.locked-skill {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.timer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.timer-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.timer-label,
.matched-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.timer-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.waiting-count-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.waiting-count-unit {
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.timer-grid {
  margin-top: 24rpx;
}

.matched-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-primary-soft);
}

.computer-offer {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(47, 107, 255, 0.16);
  border-radius: 22rpx;
  background: linear-gradient(145deg, #f4f8ff 0%, var(--color-success-soft) 100%);
}

.computer-title,
.computer-copy {
  display: block;
}

.computer-title {
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.computer-copy {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.computer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.matched-value {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
  word-break: break-all;
}

.error-copy {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-danger);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-button {
  min-height: 76rpx;
}

.disabled-button {
  opacity: 0.78;
}

.danger-button {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

@media (max-width: 420px) {
  .timer-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
