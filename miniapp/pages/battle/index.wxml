<view class="page-shell battle-page">
  <view class="hero-card">
    <view class="hero-glow hero-glow-top"></view>
    <view class="hero-glow hero-glow-bottom"></view>
    <text class="hero-eyebrow">BATTLE V1</text>
    <text class="hero-title">1v1 编程知识对战</text>
    <text class="hero-copy">和实力相近的对手正面交锋，在每一次作答中提升排名。</text>
    <view wx:if="{{myRank}}" class="hero-summary">
      <text class="hero-summary-item">{{myRank.rankText}}</text>
      <text class="hero-summary-divider"></text>
      <text class="hero-summary-item">{{leaderboardRatingLabel}} {{myRank.ratingText}}</text>
      <text class="hero-summary-divider"></text>
      <text class="hero-summary-item">{{myRank.totalBattlesText}} 场对战</text>
    </view>
  </view>

  <view wx:if="{{state === 'guest'}}" class="section-card state-box">
    <text class="state-title">登录后开启对战</text>
    <text class="state-text">登录后可查看实时排行榜、个人排名和完整战绩。</text>
    <view class="primary-button state-action" bindtap="handleLogin">去登录</view>
  </view>

  <view wx:else class="section-card leaderboard-panel">
    <view class="leaderboard-heading">
      <view class="leaderboard-heading-copy">
        <text class="leaderboard-title">{{leaderboardTitle}}</text>
        <text class="leaderboard-subtitle">{{leaderboardSubtitle}}</text>
      </view>
      <view class="leaderboard-heading-actions">
        <view class="leaderboard-live">
          <text class="live-dot"></text>
          <text>实时排名</text>
        </view>
      </view>
    </view>
    <view class="leaderboard-scope" role="tablist">
      <view
        class="scope-option {{leaderboardScope === 'TOTAL' ? 'scope-option-active' : ''}}"
        data-scope="TOTAL"
        bindtap="handleLeaderboardScopeChange"
      >总榜</view>
      <view
        class="scope-option {{leaderboardScope === 'PYTHON' ? 'scope-option-active' : ''}}"
        data-scope="PYTHON"
        bindtap="handleLeaderboardScopeChange"
      >Python 榜</view>
    </view>

    <view wx:if="{{state === 'loading'}}" class="leaderboard-state">
      <view class="loading-orbit"></view>
      <text class="leaderboard-state-title">正在更新排行榜</text>
      <text class="leaderboard-state-copy">马上为你呈现最新对战排名</text>
    </view>

    <view wx:elif="{{state === 'error'}}" class="leaderboard-state">
      <text class="state-symbol">!</text>
      <text class="leaderboard-state-title">排行榜暂时无法加载</text>
      <text class="leaderboard-state-copy">{{errorMessage}}</text>
      <view class="ghost-button compact-action" bindtap="handleRetry">重新加载</view>
    </view>

    <view wx:elif="{{state === 'empty'}}" class="leaderboard-state">
      <text class="state-symbol state-symbol-empty">—</text>
      <text class="leaderboard-state-title">排行榜正在等待首场对战</text>
      <text class="leaderboard-state-copy">完成对局后，排名会显示在这里。</text>
      <view class="ghost-button compact-action" bindtap="handleRetry">刷新排行</view>
    </view>

    <view wx:elif="{{state === 'success'}}" class="leaderboard-content">
      <view class="leaderboard-columns">
        <text class="column-rank">名次</text>
        <text class="column-player">选手</text>
        <text class="column-rating">Rating</text>
        <text class="column-battles">场次</text>
      </view>

      <scroll-view class="leaderboard-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{rankings}}"
          wx:key="userId"
          class="leaderboard-row {{item.isCurrentUser ? 'leaderboard-row-current' : ''}}"
        >
          <view class="rank-number {{item.rankClassName}}">{{item.rank}}</view>
          <view class="player-cell">
            <view class="avatar-frame">
              <image
                wx:if="{{item.avatarUrl}}"
                class="avatar-image"
                src="{{item.avatarUrl}}"
                mode="aspectFill"
              />
              <view wx:else class="avatar-fallback">{{item.avatarFallbackText}}</view>
            </view>
              <view class="player-copy">
                <view class="nickname-line">
                  <text class="nickname">{{item.nicknameText}}</text>
                  <text wx:if="{{item.isCurrentUser}}" class="me-badge">我</text>
                </view>
                <text wx:if="{{leaderboardScope === 'PYTHON'}}" class="leaderboard-tier-line">{{item.starText}} · {{item.titleText}}</text>
                <text class="leaderboard-win-rate-line">{{item.winRateText}} {{leaderboardScope === 'PYTHON' ? '排位胜率' : '总榜胜率'}}</text>
                <text class="mobile-player-meta">{{item.rankText}} · {{item.totalBattlesText}} 场 · {{item.winRateText}} {{leaderboardScope === 'PYTHON' ? '排位胜率' : '总榜胜率'}}</text>
              </view>
          </view>
          <text class="rating-value">{{item.ratingText}}</text>
          <text class="battle-count">{{item.totalBattlesText}}</text>
        </view>
      </scroll-view>

      <view wx:if="{{myRank}}" class="my-rank-dock">
        <view class="my-rank-marker">我</view>
        <view class="avatar-frame my-avatar-frame">
          <image
            wx:if="{{myRank.avatarUrl}}"
            class="avatar-image"
            src="{{myRank.avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="avatar-fallback">{{myRank.avatarFallbackText}}</view>
        </view>
        <view class="my-rank-copy">
          <text class="my-rank-name">{{myRank.nicknameText}}</text>
          <text class="my-rank-position">{{myRank.rankText}}</text>
        </view>
        <view class="my-rank-stat">
          <text class="my-rank-value">{{myRank.ratingText}}</text>
          <text class="my-rank-label">{{leaderboardRatingLabel}}</text>
        </view>
        <view class="my-rank-stat my-rank-battles">
          <text class="my-rank-value">{{myRank.totalBattlesText}}</text>
          <text class="my-rank-label">{{leaderboardBattlesLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="battle-actions">
    <view
      class="battle-action battle-action-primary"
      hover-class="battle-action-pressed"
      bindtap="handleRandomMatch"
    >
      <text class="action-icon">⚡</text>
      <text class="action-title">随机匹配</text>
      <text class="action-copy">寻找实力相近的对手</text>
    </view>
    <view
      class="battle-action"
      hover-class="battle-action-pressed"
      bindtap="handleFriendBattle"
    >
      <text class="action-icon action-icon-friend">双</text>
      <text class="action-title">好友对战</text>
      <text class="action-copy">创建或加入好友房</text>
    </view>
    <view
      class="battle-action"
      hover-class="battle-action-pressed"
      bindtap="handleHistory"
    >
      <text class="action-icon action-icon-history">↗</text>
      <text class="action-title">查询战绩</text>
      <text class="action-copy">回顾每一场对局</text>
    </view>
  </view>
</view>
