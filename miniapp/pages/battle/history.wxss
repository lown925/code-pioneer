@import "../../app.wxss";

.history-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.filter-card,
.history-card,
.footer-card {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.filter-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.filter-title + .filter-row {
  margin-top: 14rpx;
}

.filter-row + .filter-title {
  margin-top: 22rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.filter-chip-active {
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

.history-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.card-top {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.opponent-meta {
  display: flex;
  gap: 18rpx;
  min-width: 0;
}

.avatar-frame {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-primary-subtle);
  flex-shrink: 0;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.opponent-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.opponent-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.opponent-time {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.mode-badge,
.result-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.mode-badge {
  background: var(--color-card-subtle);
  color: var(--color-text-secondary);
}

.result-badge-win {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.result-badge-loss {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.result-badge-draw {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.card-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
}

.score-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.card-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-card-subtle);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.card-end-reason,
.footer-text {
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.inline-error-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.inline-error-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-danger);
}

.action-button {
  min-height: 76rpx;
}

@media (max-width: 420px) {
  .card-top {
    flex-direction: column;
  }

  .badge-row {
    justify-content: flex-start;
  }

  .card-summary-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
