@import "../../app.wxss";

.result-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.summary-card,
.opponent-card,
.stats-card,
.rating-card,
.footer-card {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.result-badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.result-badge-win {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.result-badge-loss {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.result-badge-draw {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.result-badge-waiting {
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

.summary-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.summary-mode,
.summary-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-card-subtle);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.summary-hint,
.summary-time {
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--color-text-primary);
}

.score-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.score-card {
  padding: 28rpx;
  text-align: center;
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.score-value {
  display: block;
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.opponent-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.opponent-avatar-frame {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-primary-subtle);
  flex-shrink: 0;
}

.opponent-avatar-image,
.opponent-avatar-fallback {
  width: 100%;
  height: 100%;
}

.opponent-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.opponent-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.opponent-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.opponent-name {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.stats-grid,
.rating-grid,
.performance-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.performance-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 16rpx;
}

.score-difference-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx;
}

.score-difference-value {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.tier-card {
  padding: 28rpx;
}

.tier-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.tier-title {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.tier-star {
  font-size: 42rpx;
  font-weight: 700;
  color: #ef9f4a;
}

.tier-change {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2f6bff;
}

.stat-item,
.rating-item {
  padding: 22rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
  text-align: center;
}

.stat-label,
.rating-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.stat-value,
.rating-value {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.footer-actions,
.state-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-button {
  min-height: 76rpx;
}

@media (max-width: 420px) {
  .score-grid,
  .stats-grid,
  .rating-grid,
  .performance-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .summary-top {
    flex-direction: column;
    align-items: flex-start;
  }

  .summary-meta {
    justify-content: flex-start;
  }
}
