@import "../../app.wxss";

.room-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: -32rpx -32rpx 0;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: #f3f7fb;
}

.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.custom-nav-back {
  position: absolute;
  left: 0;
  top: 50%;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  transform: translateY(-50%);
  min-height: 64rpx;
  padding: 0 12rpx;
  color: #17324d;
}

.custom-nav-back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.custom-nav-back-text,
.custom-nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #17324d;
}

.hero-card,
.invite-card,
.notice-card,
.room-meta-card,
.countdown-card,
.participant-card,
.inline-error-card,
.action-card,
.state-box {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #ffffff;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.invite-card,
.notice-card {
  background: #ffffff;
}

.invite-label {
  display: block;
  font-size: 24rpx;
  color: #6e84a3;
}

.invite-code {
  display: block;
  margin-top: 12rpx;
  font-size: 52rpx;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #17324d;
}

.invite-copy,
.notice-text,
.countdown-copy,
.inline-error-text,
.state-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.invite-copy,
.countdown-copy,
.state-text {
  color: #5f7596;
}

.notice-card {
  background: #eef4ff;
}

.notice-text {
  margin-top: 0;
  color: #2f6bff;
  font-weight: 600;
}

.invite-actions,
.state-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.compact-button {
  flex: 1;
  min-height: 72rpx;
}

.share-button {
  border: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #17324d;
}

.room-meta-card {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.meta-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f6f9fd;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  color: #6e84a3;
}

.meta-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #17324d;
}

.countdown-card {
  text-align: center;
  background: linear-gradient(135deg, #eef4ff 0%, #f8fbff 100%);
}

.countdown-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #17324d;
}

.countdown-value {
  display: block;
  margin-top: 16rpx;
  font-size: 84rpx;
  line-height: 1;
  font-weight: 700;
  color: #2f6bff;
}

.participant-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.participant-card-current {
  border: 2rpx solid #2f6bff;
  box-shadow: 0 18rpx 40rpx rgba(47, 107, 255, 0.12);
}

.participant-card-empty {
  text-align: center;
}

.participant-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-frame {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #edf3ff;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-image {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f6bff;
  font-size: 32rpx;
  font-weight: 700;
}

.participant-body {
  flex: 1;
  min-width: 0;
}

.participant-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.participant-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #17324d;
}

.me-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #17324d;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.participant-seat {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6e84a3;
}

.participant-status {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.participant-joined {
  background: #edf3ff;
  color: #2f6bff;
}

.participant-ready {
  background: #e8f8ef;
  color: #159455;
}

.participant-playing {
  background: #fff4df;
  color: #c67b00;
}

.participant-finished {
  background: #f0f4f9;
  color: #6e84a3;
}

.inline-error-text {
  margin-top: 0;
  color: #c24343;
}

.action-button {
  min-height: 88rpx;
}

.action-button-disabled {
  opacity: 0.5;
}

@media (max-width: 420px) {
  .room-meta-card {
    grid-template-columns: minmax(0, 1fr);
  }

  .invite-actions,
  .state-actions {
    flex-direction: column;
  }
}
