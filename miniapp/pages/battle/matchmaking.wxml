<view class="page-shell matchmaking-page theme-{{resolvedTheme}}">
  <view class="section-card hero-card">
    <text class="hero-eyebrow">随机匹配</text>
    <text class="hero-title">随机匹配</text>
    <text class="hero-copy">离开本页后匹配仍会继续，匹配成功后会自动进入对战房间。</text>
  </view>

  <view class="section-card skill-card">
    <text class="section-title">对战方向</text>
    <text class="section-subtitle">选择专业方向后，将从该方向已发布课程中综合出题。</text>
    <view class="skill-list">
      <view wx:for="{{tracks}}" wx:key="trackKey" class="skill-option {{selectedTrackKey === item.trackKey ? 'skill-option-selected' : ''}} {{state === 'SEARCHING' || state === 'SEARCHING_COMPUTER_AVAILABLE' || state === 'MATCHED' || state === 'JOINING' ? 'skill-option-locked' : ''}}" data-track="{{item.trackKey}}" bindtap="handleSelectTrack">
        <view>
          <text class="skill-name">{{item.shortName}} · {{item.formalName}}</text>
          <text class="skill-status">{{item.courseCountText}} · {{item.questionCountText}}</text>
          <text class="skill-status">当前题库：{{item.courseNames}}</text>
        </view>
        <text class="skill-check">{{selectedTrackKey === item.trackKey ? '已选择' : '选择'}}</text>
      </view>
    </view>
  </view>

  <view class="section-card status-card">
    <text class="section-title">{{stateTitle}}</text>
    <text class="section-subtitle">{{stateDescription}}</text>
    <text wx:if="{{selectedTrackName}}" class="locked-skill">对战方向：{{selectedTrackName}}</text>
    <text wx:if="{{state === 'SEARCHING' || state === 'SEARCHING_COMPUTER_AVAILABLE'}}" class="status-copy">{{waitingCountText}}</text>

    <view wx:if="{{state === 'SEARCHING' || state === 'SEARCHING_COMPUTER_AVAILABLE'}}" class="timer-grid">
      <view class="timer-card"><text class="timer-label">已等待时间</text><text class="timer-value">{{waitedText}}</text></view>
      <view class="timer-card"><text class="timer-label">剩余搜索时间</text><text class="timer-value">{{remainingText}}</text></view>
    </view>

    <view wx:if="{{state === 'SEARCHING_COMPUTER_AVAILABLE'}}" class="computer-offer">
      <text class="computer-title">暂时没有合适的对手</text>
      <text class="computer-copy">电脑对战不修改正式积分。入口会持续保留，继续等待不会重新锁定。</text>
      <view class="computer-actions"><button class="primary-button action-button" loading="{{isStartingComputer}}" disabled="{{isStartingComputer}}" bindtap="handleStartComputer">电脑对战</button><button class="ghost-button action-button" bindtap="handleContinueWaiting">继续等待</button></view>
    </view>

    <view wx:if="{{state === 'MATCHED' && battleId}}" class="matched-box"><text class="matched-label">匹配成功</text><text class="matched-value">正在打开对战房间，请完成准备。</text></view>
    <text wx:if="{{errorMessage}}" class="error-copy">{{errorMessage}}</text>

    <view class="action-row">
      <button wx:if="{{state === 'IDLE'}}" class="primary-button action-button" bindtap="handleStartMatchmaking">开始匹配</button>
      <button wx:elif="{{state === 'JOINING'}}" class="ghost-button action-button" loading disabled>正在加入匹配池</button>
      <block wx:elif="{{state === 'SEARCHING' || state === 'SEARCHING_COMPUTER_AVAILABLE'}}"><button class="ghost-button action-button" bindtap="handleContinueWaiting">离开页面继续等待</button><button class="danger-button action-button" loading="{{isCancelling}}" disabled="{{isCancelling}}" bindtap="handleCancelMatchmaking">取消匹配</button></block>
      <block wx:elif="{{state === 'MATCHED'}}"><text class="status-copy">正在进入对战</text><button class="ghost-button action-button" bindtap="handleBackHome">返回首页</button></block>
      <block wx:elif="{{state === 'CANCELLED'}}"><button class="primary-button action-button" bindtap="handleRetry">重新匹配</button><button class="ghost-button action-button" bindtap="handleBackHome">返回首页</button></block>
      <block wx:elif="{{state === 'EXPIRED'}}"><button wx:if="{{computerAvailable}}" class="primary-button action-button" loading="{{isStartingComputer}}" disabled="{{isStartingComputer}}" bindtap="handleStartComputer">电脑对战</button><button class="ghost-button action-button" bindtap="handleRetry">重新匹配</button><button class="ghost-button action-button" bindtap="handleBackHome">返回首页</button></block>
      <block wx:elif="{{state === 'ERROR'}}"><button class="primary-button action-button" bindtap="handleRetry">重新连接</button><button class="ghost-button action-button" bindtap="handleBackHome">返回首页</button></block>
    </view>
  </view>
</view>
