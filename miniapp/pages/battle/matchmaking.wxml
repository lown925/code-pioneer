<view class="page-shell matchmaking-page">
  <view class="section-card hero-card">
    <text class="hero-eyebrow">随机匹配</text>
    <text class="hero-title">Battle 匹配池</text>
    <text class="hero-copy">
      当前页面通过轮询服务端匹配状态推进流程，不使用 WebSocket。离开页面会停止轮询，恢复后会重新同步状态。
    </text>
  </view>

  <view class="section-card rating-card">
    <view class="rating-item">
      <text class="rating-label">当前评分</text>
      <text class="rating-value">{{ratingText}}</text>
    </view>
    <view class="rating-item">
      <text class="rating-label">当前排名</text>
      <text class="rating-value">{{rankText}}</text>
    </view>
  </view>

  <view class="section-card status-card">
    <text class="section-title">{{stateTitle}}</text>
    <text class="section-subtitle">{{stateDescription}}</text>

    <view wx:if="{{state === 'SEARCHING'}}" class="timer-grid">
      <view class="timer-card">
        <text class="timer-label">已等待时间</text>
        <text class="timer-value">{{waitedText}}</text>
      </view>
      <view class="timer-card">
        <text class="timer-label">剩余匹配时间</text>
        <text class="timer-value">{{remainingText}}</text>
      </view>
    </view>

    <view wx:if="{{state === 'MATCHED' && battleId}}" class="matched-box">
      <text class="matched-label">当前 battleId</text>
      <text class="matched-value">{{battleId}}</text>
    </view>

    <text wx:if="{{state === 'ERROR' && errorMessage}}" class="error-copy">
      {{errorMessage}}
    </text>

    <view class="action-row">
      <view wx:if="{{state === 'IDLE'}}" class="primary-button action-button" bindtap="handleStartMatchmaking">
        开始匹配
      </view>

      <view wx:elif="{{state === 'JOINING'}}" class="ghost-button action-button disabled-button">
        正在加入匹配池
      </view>

      <block wx:elif="{{state === 'SEARCHING'}}">
        <view class="primary-button action-button disabled-button">匹配进行中</view>
        <view class="ghost-button action-button" bindtap="handleCancelMatchmaking">取消匹配</view>
      </block>

      <block wx:elif="{{state === 'MATCHED'}}">
        <view class="primary-button action-button" bindtap="handleEnterRoom">进入房间</view>
        <view class="ghost-button action-button" bindtap="handleBackHome">返回首页</view>
      </block>

      <block wx:elif="{{state === 'CANCELLED' || state === 'EXPIRED'}}">
        <view class="primary-button action-button" bindtap="handleStartMatchmaking">重新开始匹配</view>
        <view class="ghost-button action-button" bindtap="handleBackHome">返回首页</view>
      </block>

      <block wx:elif="{{state === 'ERROR'}}">
        <view class="primary-button action-button" bindtap="handleRetry">重新查询状态</view>
        <view class="ghost-button action-button" bindtap="handleBackHome">返回首页</view>
      </block>
    </view>
  </view>
</view>
