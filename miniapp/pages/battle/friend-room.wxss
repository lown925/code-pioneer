@import "../../app.wxss";

.friend-room-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.custom-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: -32rpx -32rpx 0;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: var(--color-card-subtle);
}

.custom-nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-nav-back {
  position: absolute;
  left: 0;
  top: 50%;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  transform: translateY(-50%);
  min-height: 64rpx;
  padding: 0 12rpx;
  color: var(--color-text-primary);
}

.custom-nav-back-icon {
  font-size: 36rpx;
  line-height: 1;
}

.custom-nav-back-text,
.custom-nav-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.hero-card,
.entry-card,
.state-box,
.preview-card,
.inline-error-card,
.action-card {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
}

.hero-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.hero-copy {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.entry-list,
.preview-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card,
.preview-card {
  background: var(--color-card);
}

.entry-title,
.preview-title,
.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.entry-copy,
.state-text,
.preview-copy,
.inline-error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
}

.entry-copy,
.state-text,
.preview-copy {
  color: var(--color-text-secondary);
}

.invite-input-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.skill-list {
  margin-top: 20rpx;
}

.skill-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(47, 107, 255, 0.1);
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.skill-option-selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.skill-name,
.skill-copy {
  display: block;
}

.skill-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.skill-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.skill-check {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.invite-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
  border: 1rpx solid rgba(23, 50, 77, 0.08);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--color-text-primary);
  text-transform: uppercase;
}

.preview-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.preview-meta-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-card-subtle);
}

.preview-meta-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.preview-meta-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 700;
  color: var(--color-text-primary);
  word-break: break-word;
}

.inline-error-text {
  color: var(--color-danger);
}

.action-button {
  min-height: 78rpx;
  margin-top: 18rpx;
}

.action-card .action-button:first-child {
  margin-top: 0;
}

.action-button-disabled {
  opacity: 0.5;
  pointer-events: none;
}

@media (max-width: 420px) {
  .preview-meta {
    grid-template-columns: minmax(0, 1fr);
  }
}
