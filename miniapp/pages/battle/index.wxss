@import "../../app.wxss";

.battle-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #17324d 0%, var(--color-primary-strong) 56%, var(--color-primary) 100%);
  box-shadow: 0 20rpx 44rpx rgba(34, 90, 198, 0.2);
  color: var(--color-text-inverse);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-glow-top {
  top: -110rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
}

.hero-glow-bottom {
  right: 180rpx;
  bottom: -150rpx;
  width: 240rpx;
  height: 240rpx;
}

.hero-eyebrow {
  position: relative;
  display: inline-flex;
  padding: 7rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  position: relative;
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-copy {
  position: relative;
  display: block;
  max-width: 590rpx;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  line-height: 1.5;
}

.hero-summary {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 600;
}

.hero-summary-divider {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.leaderboard-panel {
  overflow: hidden;
  padding: 0;
}

.leaderboard-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 24rpx 14rpx;
}

.leaderboard-heading-copy {
  min-width: 0;
}

.leaderboard-heading-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.leaderboard-title,
.leaderboard-subtitle {
  display: block;
}

.leaderboard-tier-line {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-warning);
}

.leaderboard-win-rate-line {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-secondary);
}

.leaderboard-title {
  color: var(--color-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.leaderboard-subtitle {
  margin-top: 3rpx;
  color: var(--color-text-tertiary);
  font-size: 19rpx;
}

.leaderboard-live {
  display: flex;
  align-items: center;
  gap: 9rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: #25805a;
  font-size: 18rpx;
  font-weight: 600;
}

.leaderboard-scope {
  display: flex;
  gap: 6rpx;
  margin: 0 24rpx 14rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: var(--color-bg-secondary);
}

.scope-option {
  flex: 1;
  padding: 9rpx 12rpx;
  border-radius: 10rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  font-weight: 600;
  text-align: center;
}

.scope-option-active {
  background: var(--color-card);
  color: var(--color-primary);
  box-shadow: 0 3rpx 10rpx rgba(38, 77, 139, 0.12);
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2db97c;
  box-shadow: 0 0 0 6rpx rgba(45, 185, 124, 0.12);
}

.leaderboard-columns {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 112rpx 72rpx;
  gap: 12rpx;
  align-items: center;
  padding: 10rpx 22rpx;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-card-elevated);
  color: var(--color-text-tertiary);
  font-size: 20rpx;
}

.column-rating,
.column-battles {
  text-align: right;
}

.leaderboard-scroll {
  height: 520rpx;
  background: var(--color-card);
}

.leaderboard-row {
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 112rpx 72rpx;
  gap: 12rpx;
  align-items: center;
  min-height: 102rpx;
  padding: 10rpx 22rpx;
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.leaderboard-row-current {
  background: var(--color-bg-secondary);
}

.rank-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.rank-1 {
  background: linear-gradient(145deg, var(--color-warning-soft), #f4c755);
  color: var(--color-warning);
}

.rank-2 {
  background: linear-gradient(145deg, var(--color-bg-secondary), #c9d3df);
  color: var(--color-text-secondary);
}

.rank-3 {
  background: linear-gradient(145deg, #ffe0c3, #dc9961);
  color: var(--color-warning);
}

.player-cell,
.nickname-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.player-cell {
  gap: 14rpx;
}

.avatar-frame {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-primary-soft);
  box-shadow: 0 6rpx 14rpx rgba(23, 50, 77, 0.1);
  box-sizing: border-box;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
}

.avatar-image {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.player-copy,
.my-rank-copy {
  min-width: 0;
}

.nickname-line {
  gap: 8rpx;
}

.nickname,
.my-rank-name {
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-badge {
  flex: 0 0 auto;
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 17rpx;
  font-weight: 700;
}

.mobile-player-meta {
  display: none;
}

.rating-value,
.battle-count {
  color: var(--color-text-primary);
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.battle-count {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.my-rank-dock {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 46rpx 66rpx minmax(0, 1fr) 104rpx 70rpx;
  gap: 10rpx;
  align-items: center;
  min-height: 104rpx;
  padding: 12rpx 20rpx;
  border-top: 2rpx solid var(--color-border);
  background: linear-gradient(90deg, var(--color-primary-subtle) 0%, var(--color-card-elevated) 100%);
  box-shadow: 0 -10rpx 24rpx rgba(37, 77, 145, 0.1);
  box-sizing: border-box;
}

.my-rank-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #17324d;
  color: var(--color-text-inverse);
  font-size: 20rpx;
  font-weight: 700;
}

.my-avatar-frame {
  width: 66rpx;
  height: 66rpx;
}

.my-rank-name,
.my-rank-position,
.my-rank-value,
.my-rank-label {
  display: block;
}

.my-rank-position {
  margin-top: 3rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
}

.my-rank-stat {
  text-align: right;
}

.my-rank-value {
  color: var(--color-text-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.my-rank-label {
  margin-top: 4rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.leaderboard-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  padding: 40rpx;
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
  text-align: center;
}

.loading-orbit {
  width: 52rpx;
  height: 52rpx;
  border: 6rpx solid #dbe6ff;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 34rpx;
  font-weight: 700;
}

.state-symbol-empty {
  background: var(--color-primary-subtle);
  color: var(--color-text-secondary);
}

.leaderboard-state-title {
  margin-top: 24rpx;
  color: var(--color-text-primary);
  font-size: 29rpx;
  font-weight: 700;
}

.leaderboard-state-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
}

.compact-action {
  min-height: 68rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.state-action {
  min-height: 74rpx;
}

.battle-actions {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: auto;
}

.battle-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  min-height: 140rpx;
  padding: 14rpx 10rpx 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-card);
  box-shadow: 0 12rpx 28rpx rgba(23, 50, 77, 0.07);
  box-sizing: border-box;
  text-align: center;
  transition: transform 120ms ease, opacity 120ms ease;
}

.battle-action-primary {
  border-color: var(--color-border);
  background: linear-gradient(180deg, var(--color-card-elevated) 0%, var(--color-primary-subtle) 100%);
}

.battle-action-pressed {
  opacity: 0.78;
  transform: scale(0.97);
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 23rpx;
  font-weight: 700;
}

.action-icon-friend {
  background: #1d8d72;
  font-size: 21rpx;
}

.action-icon-history {
  background: #17324d;
}

.action-title {
  margin-top: 9rpx;
  color: var(--color-text-primary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.action-copy {
  margin-top: 4rpx;
  color: var(--color-text-secondary);
  font-size: 17rpx;
  line-height: 1.4;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 360px) {
  .leaderboard-columns,
  .leaderboard-row {
    grid-template-columns: 58rpx minmax(0, 1fr) 94rpx;
  }

  .column-battles,
  .battle-count {
    display: none;
  }

  .mobile-player-meta {
    display: block;
    margin-top: 4rpx;
    color: var(--color-text-tertiary);
    font-size: 18rpx;
  }

  .my-rank-dock {
    grid-template-columns: 46rpx 68rpx minmax(0, 1fr) 94rpx;
  }

  .my-rank-battles {
    display: none;
  }

  .battle-action {
    min-height: 124rpx;
    padding-right: 7rpx;
    padding-left: 7rpx;
  }

  .action-title {
    font-size: 23rpx;
  }

  .action-copy {
    display: none;
  }
}
