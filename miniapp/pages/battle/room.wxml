<view class="page-shell room-page theme-{{resolvedTheme}}">
  <view
    class="custom-nav"
    style="padding-top: {{navTopPadding}}px; height: {{navTopPadding + navBarHeight}}px;"
  >
    <view class="custom-nav-bar" style="height: {{navBarHeight}}px;">
      <view class="custom-nav-back" bindtap="handleNavBack">
        <text class="custom-nav-back-icon">‹</text>
        <text class="custom-nav-back-text">返回</text>
      </view>
      <text class="custom-nav-title">对战房间</text>
    </view>
  </view>

  <view class="section-card hero-card">
    <text class="hero-title">{{titleText}}</text>
    <text class="hero-copy">{{descriptionText}}</text>
  </view>

  <view wx:if="{{showInviteCode}}" class="section-card invite-card">
    <text class="invite-label">好友邀请码</text>
    <text class="invite-code">{{inviteCode}}</text>
    <text class="invite-copy">
      {{showInviteTools ? '复制邀请码或直接邀请好友，好友加入后即可准备开始。' : '请以当前显示的好友房状态为准。'}}
    </text>

    <view wx:if="{{showInviteTools}}" class="invite-actions">
      <view class="ghost-button compact-button" bindtap="handleCopyInviteCode">
        复制邀请码
      </view>
      <button class="share-button compact-button" open-type="share">
        邀请好友
      </button>
    </view>
  </view>

  <view wx:if="{{friendStatusNotice}}" class="section-card notice-card">
    <text class="notice-text">{{friendStatusNotice}}</text>
  </view>

  <view wx:if="{{state === 'LOADING'}}" class="section-card state-box">
    <text class="state-title">正在同步房间状态</text>
    <text class="state-text">系统正在获取双方玩家、准备状态和倒计时信息。</text>
  </view>

  <view wx:elif="{{state === 'ERROR'}}" class="section-card state-box">
    <text class="state-title">房间状态加载失败</text>
    <text class="state-text">{{errorMessage || '请稍后重试。'}}</text>
    <view class="state-actions">
      <view class="primary-button action-button" bindtap="handleRetry">重新查询</view>
    </view>
  </view>

  <block wx:else>
    <view class="section-card room-meta-card">
      <view class="meta-item">
        <text class="meta-label">房间模式</text>
        <text class="meta-value">{{roomModeText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">房间状态</text>
        <text class="meta-value">{{roomStatusText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">对战方向</text>
        <text class="meta-value">{{skillText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">题目数量</text>
        <text class="meta-value">{{questionCountText}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">答题时长</text>
        <text class="meta-value">{{durationText}}</text>
      </view>
    </view>

    <view wx:if="{{state === 'COUNTDOWN'}}" class="section-card countdown-card">
      <text class="countdown-title">即将开始答题</text>
      <text class="countdown-value">{{countdownText || '3'}}</text>
      <text class="countdown-copy">
        倒计时由系统统一控制，页面会自动更新。
      </text>
    </view>

    <view class="participant-list">
      <view wx:if="{{myParticipant}}" class="section-card participant-card participant-card-current">
        <view class="participant-top">
          <view class="avatar-frame">
            <image
              wx:if="{{myParticipant.avatarUrl}}"
              class="avatar-image"
              src="{{myParticipant.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="avatar-fallback">{{myParticipant.avatarFallbackText}}</view>
          </view>
          <view class="participant-body">
            <view class="participant-title-row">
              <text class="participant-name">{{myParticipant.nicknameText}}</text>
              <text class="me-badge">我</text>
            </view>
            <text class="participant-seat">{{myParticipant.seatText}}</text>
            <text class="participant-status {{myParticipant.statusClassName}}">
              {{myParticipant.statusText}}
            </text>
          </view>
        </view>
      </view>

      <view wx:if="{{opponentParticipant}}" class="section-card participant-card">
        <view class="participant-top">
          <view class="avatar-frame">
            <image
              wx:if="{{opponentParticipant.avatarUrl}}"
              class="avatar-image"
              src="{{opponentParticipant.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="avatar-fallback">{{opponentParticipant.avatarFallbackText}}</view>
          </view>
          <view class="participant-body">
            <view class="participant-title-row">
              <text class="participant-name">{{opponentParticipant.nicknameText}}</text>
            </view>
            <text class="participant-seat">{{opponentParticipant.seatText}}</text>
            <text class="participant-status {{opponentParticipant.statusClassName}}">
              {{opponentParticipant.statusText}}
            </text>
          </view>
        </view>
      </view>

      <view wx:else class="section-card participant-card participant-card-empty">
        <text class="state-title">等待好友加入</text>
        <text class="state-text">
          当前房间还未凑齐两名参与者。好友加入后，双方才能进入准备流程。
        </text>
      </view>
    </view>

    <view wx:if="{{errorMessage && state !== 'ERROR'}}" class="section-card inline-error-card">
      <text class="inline-error-text">{{errorMessage}}</text>
    </view>

    <view class="section-card action-card">
      <view
        class="primary-button action-button {{!primaryActionEnabled ? 'action-button-disabled' : ''}}"
        bindtap="handlePrimaryAction"
      >
        {{primaryActionText}}
      </view>
      <view
        wx:if="{{canLeaveRoom}}"
        class="danger-button action-button leave-room-button"
        bindtap="handleLeaveRoom"
      >
        离开房间
      </view>
    </view>
  </block>
</view>
