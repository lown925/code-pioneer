@import "../../app.wxss";

.wrong-question-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.statistics-card,
.filter-card,
.wrong-question-card,
.loading-more,
.footer-error {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.card-header,
.question-top,
.question-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-header {
  align-items: flex-start;
}

.mini-button {
  min-height: 60rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.compact-state {
  margin-top: 18rpx;
  padding: 24rpx;
}

.statistics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.statistics-item {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f6f9fd;
}

.statistics-value {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #17324d;
}

.statistics-time {
  font-size: 24rpx;
}

.statistics-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6e84a3;
}

.wrong-question-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.filter-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f4f9;
  color: #6e84a3;
  font-size: 24rpx;
  font-weight: 700;
}

.filter-chip-active {
  background: #edf3ff;
  color: #2f6bff;
}

.wrong-question-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.source-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.source-learning {
  background: #ebf3ff;
  color: #2f6bff;
}

.source-battle {
  background: #fff1f1;
  color: #c24343;
}

.question-type {
  font-size: 22rpx;
  font-weight: 700;
  color: #6e84a3;
}

.question-content {
  font-size: 30rpx;
  line-height: 1.58;
  font-weight: 700;
  color: #17324d;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.question-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.question-meta-text {
  font-size: 24rpx;
  color: #5f7596;
}

.question-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f6f9fd;
  font-size: 22rpx;
  font-weight: 700;
  color: #17324d;
}

.question-time {
  font-size: 22rpx;
  color: #6e84a3;
}

.question-action-row {
  display: flex;
  justify-content: flex-end;
}

.question-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6bff;
}

.loading-more,
.footer-error {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  text-align: center;
}

.loading-more-text,
.footer-error-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.state-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 8rpx;
}
