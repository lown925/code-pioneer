@import "../../app.wxss";
.my-courses-page,.course-list { display:flex; flex-direction:column; gap:18rpx; }.page-heading,.course-card { padding:26rpx; }.course-card { display:flex; gap:20rpx; }.course-cover { display:flex; align-items:center; justify-content:center; flex:0 0 126rpx; width:126rpx; height:142rpx; overflow:hidden; border-radius:22rpx; background:#eaf1ff; color:#2f6bff; font-size:28rpx; font-weight:700; }.course-cover image { width:100%; height:100%; }.course-copy { flex:1; min-width:0; }.course-name,.course-meta,.course-progress { display:block; }.course-name { color:#17324d; font-size:29rpx; font-weight:700; }.course-meta,.course-progress { margin-top:9rpx; color:#74859c; font-size:22rpx; }.progress-track { height:12rpx; margin-top:18rpx; overflow:hidden; border-radius:999rpx; background:#e8edf5; }.progress-fill { height:100%; background:linear-gradient(90deg,#2f6bff,#58acff); }
.paging-state { display:flex; align-items:center; justify-content:center; gap:18rpx; padding:20rpx; color:#74859c; font-size:22rpx; }.paging-button { min-width:120rpx; }
