<view class="page-shell learning-page">
  <view class="learning-hero">
    <view class="hero-orb hero-orb-one"></view>
    <view class="hero-orb hero-orb-two"></view>
    <text class="hero-eyebrow">LEARNING</text>
    <text class="hero-title">学习</text>
    <text class="hero-copy">选择一条清晰的学习路线，把知识沉淀成下一场对战的实力。</text>
  </view>

  <view class="course-section">
    <view class="section-heading">
      <view>
        <text class="section-title">目前学习课程</text>
        <text class="section-subtitle">最多展示最近学习的四门课程</text>
      </view>
    </view>

    <view wx:if="{{state === 'loading'}}" class="section-card compact-state">
      <text class="state-title">正在加载课程</text>
      <text class="state-text">正在恢复你的账号学习记录。</text>
    </view>

    <view wx:elif="{{state === 'guest'}}" class="section-card compact-state">
      <text class="state-title">登录后查看学习课程</text>
      <text class="state-text">学习进度会按账号独立保存。</text>
      <view class="primary-button compact-button" bindtap="handleLogin">去登录</view>
    </view>

    <view wx:elif="{{state === 'error'}}" class="section-card compact-state">
      <text class="state-title">课程加载失败</text>
      <text class="state-text">{{errorMessage}}</text>
      <view class="ghost-button compact-button" bindtap="handleRetry">重新加载</view>
    </view>

    <view wx:elif="{{state === 'empty'}}" class="section-card compact-state">
      <text class="state-title">还没有选择课程</text>
      <text class="state-text">从感兴趣的方向开始，建立你的第一条学习路线。</text>
      <view class="primary-button compact-button" bindtap="handleChooseCourse">选择课程</view>
    </view>

    <view wx:else class="course-grid">
      <view
        wx:for="{{courses}}"
        wx:key="courseId"
        class="course-card"
        data-course-id="{{item.courseId}}"
        hover-class="course-card-pressed"
        bindtap="handleCourseTap"
      >
        <view class="course-main">
          <view class="course-cover">
            <image
              wx:if="{{item.coverUrl && !item.coverFailed}}"
              class="cover-image"
              src="{{item.coverUrl}}"
              mode="aspectFill"
              data-course-id="{{item.courseId}}"
              binderror="handleCoverError"
            />
            <view wx:else class="cover-fallback">{{item.coverFallbackText}}</view>
          </view>
          <view class="course-copy">
            <text class="course-name">{{item.courseName}}</text>
            <text class="course-meta">{{item.chapterText}}</text>
            <text class="course-action-text">{{item.statusText}} ›</text>
          </view>
        </view>
        <view class="progress-row">
          <view class="progress-track">
            <view class="progress-fill" style="width: {{item.progressPercent}}%;"></view>
          </view>
          <text class="progress-value">{{item.progressText}}</text>
        </view>
      </view>
      <view
        class="view-more-card"
        hover-class="view-more-card-pressed"
        bindtap="handleViewMore"
      >
        <view>
          <text class="view-more-title">查看更多课程</text>
          <text class="view-more-copy">当前账号共 {{totalCourses}} 门学习课程</text>
        </view>
        <text class="view-more-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="learning-actions">
    <view class="learning-action action-select" bindtap="handleChooseCourse" hover-class="learning-action-pressed">
      <view class="action-icon">选</view>
      <text class="action-title">选择课程</text>
      <text class="action-copy">按方向筛选学习内容</text>
    </view>
    <view class="learning-action action-practice" bindtap="handlePracticeRoom" hover-class="learning-action-pressed">
      <view class="action-icon">练</view>
      <text class="action-title">练习室</text>
      <text class="action-copy">自定义课程与题量</text>
    </view>
    <view class="learning-action action-wrong" bindtap="handleWrongQuestions" hover-class="learning-action-pressed">
      <view class="action-icon">错</view>
      <text class="action-title">查看错题</text>
      <text class="action-copy">回顾学习薄弱点</text>
    </view>
  </view>
</view>
