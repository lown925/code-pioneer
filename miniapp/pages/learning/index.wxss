@import "../../app.wxss";

.learning-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.filter-bar,
.learning-card,
.loading-more,
.footer-error {
  padding: 28rpx;
}

.hero-card {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.84);
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-chip-active {
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
}

.learning-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.learning-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.learning-card-top {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.cover-frame {
  flex: 0 0 180rpx;
  width: 180rpx;
  height: 132rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #edf3ff;
}

.cover-image,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-image {
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx;
  box-sizing: border-box;
  color: #2f6bff;
  font-size: 28rpx;
  font-weight: 700;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #17324d;
}

.status-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-learning {
  background: #ebf3ff;
  color: #2f6bff;
}

.status-completed {
  background: #e8f8ef;
  color: #159455;
}

.status-not-started {
  background: #f0f4f9;
  color: #7d8aa5;
}

.progress-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.progress-percent {
  font-size: 30rpx;
  font-weight: 700;
  color: #17324d;
}

.progress-count {
  font-size: 24rpx;
  color: #6e84a3;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
}

.chapter-text,
.time-text {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5f7596;
}

.muted {
  color: #7d8aa5;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
}

.action-button {
  min-height: 72rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.loading-more,
.footer-error {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  text-align: center;
}

.loading-more-text,
.footer-error-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.footer-action {
  min-height: 72rpx;
}
