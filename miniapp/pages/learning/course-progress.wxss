@import "../../app.wxss";

.course-progress-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.hero-card,
.chapter-card {
  padding: 28rpx;
}

.hero-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-top {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.cover-frame {
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 148rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #edf3ff;
}

.cover-image,
.cover-placeholder {
  width: 100%;
  height: 100%;
}

.cover-image {
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  text-align: center;
  color: #2f6bff;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.course-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #17324d;
}

.status-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-learning {
  background: #ebf3ff;
  color: #2f6bff;
}

.status-completed {
  background: #e8f8ef;
  color: #159455;
}

.status-not-started {
  background: #f0f4f9;
  color: #7d8aa5;
}

.chapter-text,
.time-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5f7596;
}

.progress-panel {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f6f9fd;
}

.progress-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-percent {
  font-size: 34rpx;
  font-weight: 700;
  color: #17324d;
}

.progress-count {
  font-size: 24rpx;
  color: #6e84a3;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #e4edff;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
}

.hero-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-action {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4aa4ff 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-action::after {
  border: none;
}

.primary-action[disabled] {
  opacity: 0.55;
}

.detail-button {
  align-self: flex-start;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-card-current {
  border: 2rpx solid rgba(47, 107, 255, 0.22);
}

.chapter-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.chapter-index {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6bff;
}

.chapter-title-main {
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 700;
  color: #17324d;
}

.chapter-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.chapter-meta-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.chapter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.chapter-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #2f6bff;
}

.current-target-tag {
  font-size: 22rpx;
  color: #159455;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
}
