@import "../../app.wxss";

.settings-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  gap: 24rpx;
}

.settings-heading {
  padding: 8rpx 8rpx 0;
}

.settings-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.settings-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
}

.theme-options-card {
  overflow: hidden;
  padding: 0;
}

.theme-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 124rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--color-border);
}

.theme-option:last-child {
  border-bottom: 0;
}

.theme-option-selected {
  background: var(--color-primary-soft);
}

.theme-option-indicator {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
}

.theme-option-indicator-selected {
  border-color: var(--color-primary);
}

.theme-option-indicator-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.theme-option-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.theme-option-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.theme-option-description {
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}
