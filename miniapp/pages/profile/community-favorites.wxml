<view class="page-shell profile-community-page">
  <view wx:if="{{state === 'loading'}}" class="section-card state-box">
    <text class="state-title">收藏加载中</text>
    <text class="state-text">正在获取你收藏过的帖子，请稍候。</text>
  </view>

  <view wx:elif="{{state === 'error' || state === 'unauthorized'}}" class="section-card state-box">
    <text class="state-title">暂时无法查看</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="primary-button state-button" bindtap="handleRetry">重新加载</view>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="section-card state-box">
    <text class="state-title">还没有收藏帖子</text>
    <text class="state-text">在帖子详情页点一次收藏，这里就会出现相应记录。</text>
  </view>

  <block wx:else>
    <view class="card-list">
      <view
        wx:for="{{items}}"
        wx:key="post.postId"
        class="section-card post-card"
        data-post-id="{{item.post.postId}}"
        bindtap="handleOpenDetail"
      >
        <view class="post-top">
          <text class="post-status">{{item.post.category.name}}</text>
          <text class="post-time">收藏于 {{item.favoritedAtText || '刚刚'}}</text>
        </view>
        <text class="post-title">{{item.titleText}}</text>
        <text class="post-preview">{{item.previewText}}</text>
        <view class="post-meta">
          <text class="post-meta-item">{{item.authorName}}</text>
          <text class="post-meta-item">收藏 {{item.post.favoriteCount}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isLoadingMore}}" class="section-card loading-more">
      <text class="loading-more-text">正在加载更多收藏...</text>
    </view>

    <view wx:elif="{{!hasMore && items.length > 0}}" class="section-card loading-more">
      <text class="loading-more-text">已经加载全部收藏</text>
    </view>
  </block>
</view>
