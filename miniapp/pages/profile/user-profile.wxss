@import "../../app.wxss";

.user-profile-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.profile-card {
  padding: 30rpx;
}

.profile-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #e8f0ff 0%, #d7e7ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.profile-avatar-image {
  width: 100%;
  height: 100%;
}

.profile-avatar-text {
  font-size: 46rpx;
  font-weight: 700;
  color: #2f6bff;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #17324d;
}

.profile-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5f7596;
}

.metric-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f6f9fd;
  box-shadow: inset 0 0 0 1rpx rgba(47, 107, 255, 0.08);
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #17324d;
}

.metric-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #17324d;
}

.metric-helper {
  font-size: 22rpx;
  line-height: 1.6;
  color: #6e84a3;
}

.state-button {
  min-height: 72rpx;
}
