@import "../../app.wxss";

.follow-list-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.summary-card,
.user-card,
.loading-more {
  padding: 28rpx;
}

.summary-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #17324d;
}

.summary-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6e84a3;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eaf1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.user-avatar-image {
  width: 100%;
  height: 100%;
}

.user-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #2f6bff;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #17324d;
}

.user-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6e84a3;
}

.user-tag {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
}

.user-tag-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #2f6bff;
}

.loading-more {
  display: flex;
  justify-content: center;
}

.loading-more-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.state-button {
  min-height: 72rpx;
}
