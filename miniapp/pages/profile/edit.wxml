<view class="page-shell profile-edit-page theme-{{resolvedTheme}}">
  <battle-match-floating compact-only="{{true}}" />
  <view class="intro-card">
    <text class="intro-eyebrow">个人名片</text>
    <text class="intro-title">让队友认识真实的你</text>
    <text class="intro-copy">头像和昵称由你主动选择，仅用于码站先锋内的个人主页和排行榜。</text>
  </view>

  <view class="section-card form-card">
    <view class="avatar-field">
      <button
        class="avatar-button"
        open-type="chooseAvatar"
        disabled="{{isSaving}}"
        bindchooseavatar="handleChooseAvatar"
      >
        <image
          wx:if="{{hasAvatarPreview}}"
          class="avatar-preview"
          src="{{previewAvatarUrl}}"
          mode="aspectFill"
          binderror="handleAvatarLoadError"
        />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-placeholder-mark">+</text>
          <text class="avatar-placeholder-text">选择头像</text>
        </view>
        <view class="avatar-edit-badge">更换</view>
      </button>
      <text class="avatar-helper">支持 JPG、PNG、WebP，文件不超过 2 MB</text>
    </view>

    <view class="nickname-field">
      <text class="field-label">昵称</text>
      <view class="nickname-input-shell">
        <input
          class="nickname-input"
          type="nickname"
          value="{{nickname}}"
          maxlength="30"
          disabled="{{isSaving}}"
          placeholder="填写你希望展示的昵称"
          bindinput="handleNicknameInput"
        />
        <text class="nickname-count">{{nickname.length}} / 30</text>
      </view>
      <text class="field-helper">点击输入框时可使用微信提供的昵称快捷填写能力。</text>
    </view>

    <view wx:if="{{errorMessage}}" class="error-bar">
      <text class="error-text">{{errorMessage}}</text>
    </view>

    <button
      class="save-button"
      loading="{{isSaving}}"
      disabled="{{isSaving}}"
      bindtap="handleSave"
    >
      {{isSaving ? '正在保存' : '保存个人资料'}}
    </button>

    <button
      wx:if="{{onboarding}}"
      class="skip-button"
      disabled="{{isSaving}}"
      bindtap="handleSkip"
    >
      暂时跳过，稍后在“我的”中完善
    </button>
  </view>

  <view class="privacy-note">
    <text class="privacy-title">隐私说明</text>
    <text class="privacy-copy">小程序不会自动读取你的微信头像或昵称。只有你主动选择并点击保存后，资料才会上传到码站先锋服务端。</text>
  </view>
</view>
