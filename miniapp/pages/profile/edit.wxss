@import "../../app.wxss";

.profile-edit-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.intro-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 38rpx;
  border-radius: 30rpx;
  background: linear-gradient(140deg, #17324d 0%, #2456a6 58%, var(--color-primary) 100%);
  box-shadow: 0 22rpx 46rpx rgba(30, 75, 139, 0.2);
}

.intro-card::after {
  content: "";
  position: absolute;
  top: -66rpx;
  right: -44rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.intro-eyebrow,
.intro-title,
.intro-copy {
  position: relative;
  z-index: 1;
  display: block;
}

.intro-eyebrow {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.7);
}

.intro-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.intro-copy {
  margin-top: 14rpx;
  max-width: 580rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.82);
}

.form-card {
  padding: 36rpx 30rpx 32rpx;
}

.avatar-field {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-button {
  position: relative;
  width: 184rpx;
  height: 184rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border-radius: 50%;
  background: var(--color-primary-soft);
  box-shadow: 0 14rpx 30rpx rgba(47, 107, 255, 0.16), inset 0 0 0 2rpx #ffffff;
}

.avatar-button::after,
.save-button::after,
.skip-button::after {
  border: none;
}

.avatar-preview,
.avatar-placeholder {
  width: 184rpx;
  height: 184rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--color-primary);
}

.avatar-placeholder-mark {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 300;
}

.avatar-placeholder-text {
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 600;
}

.avatar-edit-badge {
  position: absolute;
  right: -8rpx;
  bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 46rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 20rpx;
  line-height: 1;
}

.avatar-helper {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.nickname-field {
  margin-top: 38rpx;
}

.field-label {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.nickname-input-shell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  min-height: 92rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
  box-shadow: inset 0 0 0 1rpx rgba(47, 107, 255, 0.09);
}

.nickname-input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.nickname-count {
  flex: 0 0 auto;
  font-size: 21rpx;
  color: var(--color-text-tertiary);
}

.field-helper {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.error-bar {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--color-danger-soft);
}

.error-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--color-danger);
}

.save-button {
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-accent) 100%);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-shadow: 0 16rpx 28rpx rgba(47, 107, 255, 0.22);
}

.save-button[disabled] {
  opacity: 0.64;
}

.skip-button {
  margin-top: 12rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 72rpx;
}

.privacy-note {
  padding: 6rpx 10rpx 0;
}

.privacy-title,
.privacy-copy {
  display: block;
}

.privacy-title {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.privacy-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--color-text-tertiary);
}
