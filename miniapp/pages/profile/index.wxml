<view class="page-shell profile-page theme-{{resolvedTheme}}">
  <battle-match-floating />
  <view wx:if="{{!isAuthenticated}}" class="section-card guest-card">
    <text class="guest-title">登录后查看个人主页</text>
    <text class="guest-copy">
      登录后可查看 Battle 战绩、统一错题、学习入口和账号资料。
    </text>
    <view class="primary-button guest-action" bindtap="handleLogin">去登录</view>
  </view>

  <block wx:else>
    <view class="section-card profile-card">
      <view class="profile-head">
        <view class="profile-avatar">
          <image
            wx:if="{{user.avatarUrl}}"
            class="profile-avatar-image"
            src="{{user.avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else class="profile-avatar-text">{{profileInitial}}</text>
        </view>

        <view class="profile-main">
          <view class="profile-name-row">
            <text class="profile-name">{{displayName}}</text>
            <view class="profile-edit-button" bindtap="handleEditProfile">编辑资料</view>
          </view>
          <text class="profile-meta">Battle Rating {{battleSummary ? battleSummary.ratingText : user.battleRating}}</text>
        </view>
      </view>

      <view wx:if="{{overviewErrorMessage && !isOverviewLoading}}" class="overview-error-bar">
        <text class="overview-error-text">{{overviewErrorMessage}}</text>
        <view class="ghost-button overview-error-action" bindtap="handleOverviewRetry">重试</view>
      </view>

      <view class="metric-grid">
        <view
          wx:for="{{metrics}}"
          wx:key="key"
          class="metric-card"
          data-metric-key="{{item.key}}"
          bindtap="handleMetricTap"
        >
          <text class="metric-value">{{item.valueText}}</text>
          <text class="metric-title">{{item.title}}</text>
          <text class="metric-helper">{{item.helperText}}</text>
        </view>
      </view>

      <view class="profile-footer">
        <view class="profile-footer-chip" bindtap="handleLearningEntry">
          <text class="profile-footer-chip-title">学习中心</text>
        </view>
        <text wx:if="{{battleSummary}}" class="profile-footer-text">{{battleSummary.recordText}}</text>
      </view>
    </view>

    <view class="section-card action-card">
      <text class="section-title">账号操作</text>
      <text class="section-subtitle">退出登录会清理当前本地登录态，并返回游客视图。</text>
      <button
        class="logout-button"
        loading="{{isLoggingOut}}"
        disabled="{{isLoggingOut}}"
        bindtap="handleLogout"
      >
        退出登录
      </button>
    </view>
  </block>

  <view class="section-card settings-card" bindtap="handleSettings">
    <view class="settings-entry-copy">
      <text class="settings-entry-title">设置</text>
      <text class="settings-entry-subtitle">主题模式：{{themeMode === 'system' ? '跟随系统' : themeMode === 'dark' ? '深色模式' : '浅色模式'}}</text>
    </view>
    <text class="settings-entry-arrow">›</text>
  </view>
</view>
