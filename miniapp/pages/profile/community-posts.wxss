@import "../../app.wxss";

.profile-community-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-card,
.loading-more {
  padding: 28rpx;
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.post-status {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 22rpx;
  font-weight: 600;
}

.post-time {
  font-size: 22rpx;
  color: #6e84a3;
}

.post-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #17324d;
}

.post-preview {
  display: -webkit-box;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f7596;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.post-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.post-meta-item {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f6f9fd;
  font-size: 22rpx;
  color: #6e84a3;
}

.loading-more {
  display: flex;
  justify-content: center;
  text-align: center;
}

.loading-more-text {
  font-size: 24rpx;
  color: #6e84a3;
}

.state-button {
  min-height: 72rpx;
}
