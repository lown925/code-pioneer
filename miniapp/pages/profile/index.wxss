@import "../../app.wxss";

.profile-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.guest-card,
.profile-card,
.action-card {
  padding: 30rpx;
}

.guest-card {
  background: linear-gradient(145deg, #17324d 0%, var(--color-primary) 100%);
  color: var(--color-text-inverse);
}

.guest-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.guest-copy {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.84);
}

.guest-action {
  margin-top: 26rpx;
}

.guest-hint {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.profile-card {
  background: linear-gradient(180deg, var(--color-card) 0%, var(--color-card-elevated) 100%);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, var(--color-primary-soft) 0%, #d7e7ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.profile-avatar-image {
  width: 100%;
  height: 100%;
}

.profile-avatar-text {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.profile-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--color-text-primary);
}

.profile-edit-button {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.profile-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.overview-error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-danger-soft);
}

.overview-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-danger);
}

.overview-error-action {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--color-card-subtle);
  box-shadow: inset 0 0 0 1rpx rgba(47, 107, 255, 0.08);
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.metric-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.metric-helper {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.profile-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(23, 50, 77, 0.08);
}

.profile-footer-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
}

.profile-footer-chip-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.profile-footer-text {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.logout-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #17324d;
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.logout-button::after {
  border: none;
}

.settings-card {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
}

.settings-entry-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.settings-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.settings-entry-subtitle {
  font-size: 23rpx;
  color: var(--color-text-secondary);
}

.settings-entry-arrow {
  margin-left: 24rpx;
  color: var(--color-text-tertiary);
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}
