@import "../../app.wxss";

.profile-hero,
.summary-card,
.entry-card,
.action-card {
  padding: 30rpx;
}

.profile-hero {
  background: linear-gradient(145deg, #17324d 0%, #2f6bff 100%);
  color: #ffffff;
}

.profile-eyebrow {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.profile-title {
  display: block;
  margin-top: 24rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.profile-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.84);
}

.env-pill {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.profile-action {
  margin-top: 8rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(23, 50, 77, 0.08);
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 26rpx;
  color: #6e84a3;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #17324d;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.entry-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f6f9fd;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #17324d;
}

.entry-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7596;
}

.logout-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #17324d;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.logout-button::after {
  border: none;
}
