<view class="page-shell course-list-page theme-{{resolvedTheme}}">
  <battle-match-floating />
  <view class="course-hero">
    <text class="hero-eyebrow">课程库</text>
    <text class="hero-title">选择课程</text>
    <text class="hero-copy">按学习方向筛选课程，点击卡片右侧按钮加入学习页。</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        wx:for="{{categoryFilters}}"
        wx:key="value"
        class="filter-chip {{selectedCategory === item.value ? 'filter-chip-active' : ''}}"
        data-category="{{item.value}}"
        bindtap="handleCategoryTap"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{state === 'loading'}}" class="section-card state-box">
    <text class="state-title">课程加载中</text>
  </view>
  <view wx:elif="{{state === 'error'}}" class="section-card state-box">
    <text class="state-title">课程加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="primary-button" bindtap="handleRetry">重新加载</view>
  </view>
  <view wx:elif="{{state === 'empty'}}" class="section-card state-box">
    <text class="state-title">该方向暂时没有课程</text>
    <text class="state-text">可以切换其他方向查看。</text>
  </view>

  <view wx:else class="course-list">
    <view
      wx:for="{{courses}}"
      wx:key="id"
      class="section-card course-card {{item.isSelected ? 'course-card-selected' : ''}}"
      data-course-id="{{item.id}}"
      bindtap="openCourseDetail"
    >
      <view class="course-cover">
        <image
          wx:if="{{item.coverUrl && !item.coverFailed}}"
          src="{{item.coverUrl}}"
          mode="aspectFill"
          data-course-id="{{item.id}}"
          binderror="handleCoverError"
        />
        <text wx:else>{{item.coverText}}</text>
      </view>

      <view class="course-main">
        <view class="course-tags">
          <text>{{item.categoryText}}</text>
          <text>{{item.languageText}}</text>
        </view>
        <text class="course-title">{{item.title}}</text>
        <text class="course-summary">{{item.summary}}</text>
        <text class="course-meta">{{item.chapterCount}} 节 · {{item.estimatedMinutesText}} · {{item.difficultyText}}</text>
        <text class="course-progress">当前进度 {{item.progressPercent}}%</text>
      </view>

      <view class="course-side">
        <view
          class="selection-button {{item.isSelected ? 'selection-button-selected' : ''}} {{item.isSelectionUpdating ? 'selection-button-disabled' : ''}}"
          data-course-id="{{item.id}}"
          catchtap="handleSelectionTap"
        >
          {{item.selectionButtonText}}
        </view>
        <text class="detail-link">查看详情 ›</text>
      </view>
    </view>
  </view>
</view>
