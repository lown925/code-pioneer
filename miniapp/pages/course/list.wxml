<view class="page-shell course-list-page">
  <view class="page-header section-card">
    <text class="section-title">全部课程</text>
    <text class="section-subtitle">只展示后端已发布课程，草稿和下架课程不会出现在这里。</text>
  </view>

  <view wx:if="{{state === 'loading'}}" class="section-card state-box">
    <text class="state-title">课程列表加载中</text>
    <text class="state-text">正在获取课程数据，请稍候。</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="section-card state-box">
    <text class="state-title">课程列表加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="primary-button" bindtap="handleRetry">重新加载</view>
  </view>

  <view wx:elif="{{state === 'empty'}}" class="section-card state-box">
    <text class="state-title">暂无可学习课程</text>
    <text class="state-text">当前还没有已发布课程，请稍后再来查看。</text>
  </view>

  <view wx:else class="course-list">
    <view class="list-summary section-card">
      <text class="list-summary-text">当前共展示 {{total}} 门已发布课程</text>
      <text class="list-summary-text">下拉页面可重新拉取课程数据</text>
    </view>

    <view
      wx:for="{{courses}}"
      wx:key="id"
      class="section-card course-card"
      data-course-id="{{item.id}}"
      bindtap="openCourseDetail"
    >
      <view class="course-card-top">
        <view class="course-card-main">
          <text class="course-title">{{item.title}}</text>
          <text class="course-summary">{{item.summary}}</text>
        </view>
        <text class="course-badge">{{item.difficultyText}}</text>
      </view>

      <view class="course-meta-grid">
        <view class="course-meta-item">
          <text class="course-meta-label">预计学习</text>
          <text class="course-meta-value">{{item.estimatedMinutesText}}</text>
        </view>
        <view class="course-meta-item">
          <text class="course-meta-label">章节数量</text>
          <text class="course-meta-value">{{item.chapterCount}}</text>
        </view>
        <view class="course-meta-item">
          <text class="course-meta-label">学习人数</text>
          <text class="course-meta-value">{{item.learnerCount}}</text>
        </view>
        <view class="course-meta-item">
          <text class="course-meta-label">当前进度</text>
          <text class="course-meta-value">{{item.progressPercent}}%</text>
        </view>
      </view>

      <view class="course-card-footer">
        <view class="primary-button course-action">查看课程详情</view>
      </view>
    </view>
  </view>
</view>
