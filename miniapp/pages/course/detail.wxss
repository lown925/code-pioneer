@import "../../app.wxss";

.course-detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.overview-card,
.audience-card,
.objectives-card,
.chapter-card {
  padding: 30rpx;
}

.overview-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--color-text-primary);
}

.overview-summary,
.overview-description {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.overview-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}

.overview-pill {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
}

.overview-pill-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.overview-pill-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-grid-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.overview-grid-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.overview-grid-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.last-learned-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.last-learned-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.last-learned-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.overview-actions {
  margin-top: 24rpx;
}

.overview-action {
  min-height: 76rpx;
}

.objective-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.objective-item {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--color-card-subtle);
}

.objective-index {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 42rpx;
  flex-shrink: 0;
}

.objective-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-primary);
}

.compact-state {
  padding: 32rpx 0 4rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.chapter-card {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
}

.chapter-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-accent) 100%);
  color: var(--color-text-inverse);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
  flex-shrink: 0;
}

.chapter-main {
  flex: 1;
  min-width: 0;
}

.chapter-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.chapter-title {
  display: block;
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.status-tag {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-learning {
  background: var(--color-primary-subtle);
  color: var(--color-primary);
}

.status-completed {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-not-started {
  background: var(--color-bg-secondary);
  color: var(--color-text-tertiary);
}

.chapter-summary {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.chapter-quiz-status,
.chapter-time-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.chapter-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22rpx;
}

.chapter-footer-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.chapter-minutes {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.chapter-last-learned {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.chapter-link {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}
