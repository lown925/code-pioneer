@import "../../app.wxss";

.course-list-page,
.course-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.course-hero {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #173f70, var(--color-primary));
  color: var(--color-text-inverse);
}

.hero-eyebrow {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  opacity: 0.75;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 23rpx;
  line-height: 1.55;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx;
}

.filter-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-card);
  color: var(--color-text-secondary);
  font-size: 22rpx;
  box-shadow: 0 7rpx 18rpx rgba(23, 50, 77, 0.06);
}

.filter-chip-active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-weight: 700;
}

.course-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx;
  border: 2rpx solid transparent;
}

.course-card-selected {
  border-color: var(--color-border);
  background: linear-gradient(135deg, var(--color-card), #f7f9ff);
}

.course-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 124rpx;
  width: 124rpx;
  min-height: 176rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.course-cover image {
  width: 100%;
  height: 100%;
}

.course-main {
  flex: 1;
  min-width: 0;
}

.course-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.course-tags text {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary-subtle);
  color: var(--color-primary);
  font-size: 17rpx;
}

.course-title {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.course-meta,
.course-progress {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-tertiary);
  font-size: 18rpx;
}

.course-progress {
  color: var(--color-text-secondary);
}

.course-side {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex: 0 0 138rpx;
  flex-direction: column;
  width: 138rpx;
  padding: 6rpx 0 4rpx;
  box-sizing: border-box;
}

.selection-button {
  width: 138rpx;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.selection-button-selected {
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

.selection-button-disabled {
  opacity: 0.55;
}

.detail-link {
  color: #72849a;
  font-size: 19rpx;
}

@media (max-width: 340px) {
  .course-cover {
    flex-basis: 108rpx;
    width: 108rpx;
  }

  .course-side,
  .selection-button {
    width: 126rpx;
  }

  .course-side {
    flex-basis: 126rpx;
  }
}
