<view class="page-shell course-detail-page">
  <view wx:if="{{state === 'loading'}}" class="section-card state-box">
    <text class="state-title">课程详情加载中</text>
    <text class="state-text">正在读取课程与章节信息，请稍候。</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="section-card state-box">
    <text class="state-title">课程详情加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <view class="primary-button" bindtap="handleRetry">重新加载</view>
  </view>

  <block wx:else>
    <view class="section-card overview-card">
      <text class="overview-title">{{title}}</text>
      <text class="overview-summary">{{summary}}</text>
      <text wx:if="{{description}}" class="overview-description">{{description}}</text>

      <view class="overview-meta">
        <view class="overview-pill">
          <text class="overview-pill-label">难度</text>
          <text class="overview-pill-value">{{difficultyText}}</text>
        </view>
        <view class="overview-pill">
          <text class="overview-pill-label">预计学习</text>
          <text class="overview-pill-value">{{estimatedMinutesText}}</text>
        </view>
      </view>

      <view class="overview-grid">
        <view class="overview-grid-item">
          <text class="overview-grid-label">学习人数</text>
          <text class="overview-grid-value">{{learnerCount}}</text>
        </view>
        <view class="overview-grid-item">
          <text class="overview-grid-label">当前进度</text>
          <text class="overview-grid-value">{{progressPercent}}%</text>
        </view>
      </view>
    </view>

    <view class="section-card audience-card">
      <text class="section-title">适合人群</text>
      <text class="section-subtitle">{{targetAudience}}</text>
    </view>

    <view class="section-card objectives-card">
      <text class="section-title">学习目标</text>
      <view wx:if="{{learningObjectives.length > 0}}" class="objective-list">
        <view wx:for="{{learningObjectives}}" wx:key="index" class="objective-item">
          <text class="objective-index">{{index + 1}}</text>
          <text class="objective-text">{{item}}</text>
        </view>
      </view>
      <view wx:else class="state-box compact-state">
        <text class="state-text">当前课程暂未配置学习目标。</text>
      </view>
    </view>

    <view class="section-head">
      <view>
        <text class="section-title">章节目录</text>
        <text class="section-subtitle">当前仅展示已发布章节</text>
      </view>
    </view>

    <view wx:if="{{chapters.length > 0}}" class="chapter-list">
      <view
        wx:for="{{chapters}}"
        wx:key="id"
        class="section-card chapter-card"
        bindtap="handleChapterTap"
      >
        <view class="chapter-badge">{{index + 1}}</view>
        <view class="chapter-main">
          <text class="chapter-title">{{item.title}}</text>
          <text class="chapter-summary">{{item.summary || '当前章节暂未填写简介。'}}</text>
          <view class="chapter-footer">
            <text class="chapter-minutes">{{item.estimatedMinutesText}}</text>
            <text class="chapter-link">进入学习</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="section-card state-box">
      <text class="state-title">暂无章节</text>
      <text class="state-text">这门课程还没有可公开展示的章节。</text>
    </view>
  </block>
</view>
