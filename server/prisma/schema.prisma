// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum CourseDifficulty {
  BEGINNER
  BASIC
  INTERMEDIATE
  ADVANCED
}

enum ChapterStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum ContentBlockType {
  TEXT
  HEADING
  IMAGE
  CODE
  TIP
  WARNING
  EXAMPLE
  QUESTION
}

enum UserStatus {
  NORMAL
  DISABLED
  DELETED
}

enum CommunityCategoryStatus {
  ENABLED
  DISABLED
}

enum CommunityPostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum CommunityCommentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum LearningStatus {
  NOT_STARTED
  LEARNING
  COMPLETED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  CODE_FILL
}

enum BattleMode {
  RANKED
  FRIEND
}

enum BattleRoomStatus {
  WAITING
  READY
  COUNTDOWN
  IN_PROGRESS
  SETTLING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BattleParticipantStatus {
  JOINED
  READY
  PLAYING
  SUBMITTED
  FORFEITED
  COMPLETED
}

enum BattleResult {
  WIN
  LOSS
  DRAW
  NONE
}

enum BattleQuestionType {
  SINGLE_CHOICE
  CODE_FILL
}

enum BattleQuestionPresentation {
  TEXT_CHOICE
  CODE_READING
  CODE_PURPOSE
  OUTPUT_PREDICTION
  BUG_FIX
  CODE_COMPLETION_CHOICE
  CODE_SNIPPET_CHOICE
  INPUT_CODE_FILL
}

enum BattleQuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum BattleMatchQueueStatus {
  SEARCHING
  MATCHED
  CANCELLED
  EXPIRED
}

enum BattleInvitationStatus {
  ACTIVE
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum BattleEndReason {
  NORMAL
  USER_FORFEIT
  MATCH_TIMEOUT
  SYSTEM_CANCELLED
  EXPIRED
}

enum BattleRatingReason {
  BATTLE_RESULT
  ADMIN_ADJUSTMENT
  INITIALIZATION
}

model SystemHealth {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  openId                 String                     @unique @map("open_id")
  unionId                String?                    @unique @map("union_id")
  nickname               String?
  avatarUrl              String?                    @map("avatar_url")
  status                 UserStatus                 @default(NORMAL)
  experience             Int                        @default(0)
  battleRating           Int                        @default(1000) @map("battle_rating")
  continuousLearningDays Int                        @default(0) @map("continuous_learning_days")
  lastLearningDate       DateTime?                  @map("last_learning_date")
  lastLoginAt            DateTime?                  @map("last_login_at")
  disabledReason         String?                    @map("disabled_reason")
  disabledAt             DateTime?                  @map("disabled_at")
  deletedAt              DateTime?                  @map("deleted_at")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  sessions               UserSession[]
  courseLearningRecords  CourseLearningRecord[]
  chapterLearningRecords ChapterLearningRecord[]
  quizAttempts           QuizAttempt[]
  battleProfile          BattleProfile?
  createdBattleRooms     BattleRoom[]               @relation("BattleRoomCreatedBy")
  wonBattleRooms         BattleRoom[]               @relation("BattleRoomWinner")
  battleParticipants     BattleParticipant[]
  battleAnswers          BattleAnswer[]
  sentBattleInvitations  BattleInvitation[]         @relation("BattleInvitationInviter")
  receivedBattleInvites  BattleInvitation[]         @relation("BattleInvitationInvitee")
  battleRatingLogs       BattleRatingLog[]
  battleMatchQueue       BattleMatchQueue?
  communityPosts         CommunityPost[]
  communityPostFavorites CommunityPostFavorite[]
  communityPostHistories CommunityPostViewHistory[]
  communityPostLikes     CommunityPostLike[]
  communityComments      CommunityComment[]
  followingRelations     UserFollow[]               @relation("UserFollowFollower")
  followerRelations      UserFollow[]               @relation("UserFollowFollowed")

  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@map("users")
}

model UserFollow {
  id             String   @id @default(uuid()) @db.Uuid
  followerUserId String   @map("follower_user_id") @db.Uuid
  followedUserId String   @map("followed_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  followerUser   User     @relation("UserFollowFollower", fields: [followerUserId], references: [id])
  followedUser   User     @relation("UserFollowFollowed", fields: [followedUserId], references: [id])

  @@unique([followerUserId, followedUserId])
  @@index([followerUserId, createdAt])
  @@index([followedUserId, createdAt])
  @@map("user_follows")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String?   @map("refresh_token_hash")
  deviceInfo       String?   @map("device_info")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model Course {
  id                 String                  @id @default(uuid()) @db.Uuid
  title              String
  slug               String                  @unique
  summary            String
  description        String?
  coverUrl           String?                 @map("cover_url")
  difficulty         CourseDifficulty        @default(BEGINNER)
  estimatedMinutes   Int                     @default(0) @map("estimated_minutes")
  targetAudience     String?                 @map("target_audience")
  learningObjectives Json?                   @map("learning_objectives")
  status             CourseStatus            @default(DRAFT)
  sortOrder          Int                     @default(0) @map("sort_order")
  learnerCount       Int                     @default(0) @map("learner_count")
  publishedAt        DateTime?               @map("published_at")
  createdById        String?                 @map("created_by_id") @db.Uuid
  updatedById        String?                 @map("updated_by_id") @db.Uuid
  deletedAt          DateTime?               @map("deleted_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  chapters           CourseChapter[]
  learningRecords    CourseLearningRecord[]
  chapterLearners    ChapterLearningRecord[]

  @@index([status, sortOrder])
  @@index([createdAt])
  @@map("courses")
}

model CourseChapter {
  id               String                  @id @default(uuid()) @db.Uuid
  courseId         String                  @map("course_id") @db.Uuid
  title            String
  summary          String?
  estimatedMinutes Int                     @default(0) @map("estimated_minutes")
  sortOrder        Int                     @default(0) @map("sort_order")
  status           ChapterStatus           @default(DRAFT)
  publishedAt      DateTime?               @map("published_at")
  createdById      String?                 @map("created_by_id") @db.Uuid
  updatedById      String?                 @map("updated_by_id") @db.Uuid
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  course           Course                  @relation(fields: [courseId], references: [id])
  contentBlocks    ChapterContentBlock[]
  learningRecords  ChapterLearningRecord[]
  lastLearnedIn    CourseLearningRecord[]  @relation("CourseLearningRecordLastChapter")
  quiz             Quiz?

  @@index([courseId, status, sortOrder])
  @@index([courseId])
  @@map("course_chapters")
}

model ChapterContentBlock {
  id        String           @id @default(uuid()) @db.Uuid
  chapterId String           @map("chapter_id") @db.Uuid
  type      ContentBlockType
  sortOrder Int              @map("sort_order")
  content   Json
  isVisible Boolean          @default(true) @map("is_visible")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  chapter   CourseChapter    @relation(fields: [chapterId], references: [id])

  @@index([chapterId, sortOrder])
  @@index([chapterId])
  @@map("chapter_content_blocks")
}

model CourseLearningRecord {
  id                        String         @id @default(uuid()) @db.Uuid
  userId                    String         @map("user_id") @db.Uuid
  courseId                  String         @map("course_id") @db.Uuid
  status                    LearningStatus @default(LEARNING)
  completedChapterCount     Int            @default(0) @map("completed_chapter_count")
  totalChapterCountSnapshot Int            @default(0) @map("total_chapter_count_snapshot")
  progressPercent           Decimal        @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastChapterId             String?        @map("last_chapter_id") @db.Uuid
  startedAt                 DateTime       @default(now()) @map("started_at")
  lastLearnedAt             DateTime?      @map("last_learned_at")
  completedAt               DateTime?      @map("completed_at")
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")
  user                      User           @relation(fields: [userId], references: [id])
  course                    Course         @relation(fields: [courseId], references: [id])
  lastChapter               CourseChapter? @relation("CourseLearningRecordLastChapter", fields: [lastChapterId], references: [id])

  @@unique([userId, courseId])
  @@map("course_learning_records")
}

model ChapterLearningRecord {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  courseId       String         @map("course_id") @db.Uuid
  chapterId      String         @map("chapter_id") @db.Uuid
  status         LearningStatus @default(LEARNING)
  firstStartedAt DateTime       @default(now()) @map("first_started_at")
  lastLearnedAt  DateTime       @default(now()) @map("last_learned_at")
  completedAt    DateTime?      @map("completed_at")
  quizCompleted  Boolean        @default(false) @map("quiz_completed")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id])
  course         Course         @relation(fields: [courseId], references: [id])
  chapter        CourseChapter  @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId])
  @@index([userId, lastLearnedAt])
  @@map("chapter_learning_records")
}

model Quiz {
  id               String         @id @default(uuid()) @db.Uuid
  chapterId        String         @unique @map("chapter_id") @db.Uuid
  title            String
  description      String?
  passScorePercent Int            @default(60) @map("pass_score_percent")
  status           QuizStatus     @default(DRAFT)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  chapter          CourseChapter  @relation(fields: [chapterId], references: [id])
  questions        QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([status])
  @@map("quizzes")
}

model QuizQuestion {
  id                    String                      @id @default(uuid()) @db.Uuid
  quizId                String                      @map("quiz_id") @db.Uuid
  type                  QuestionType
  content               String
  explanation           String?
  score                 Int
  sortOrder             Int                         @map("sort_order")
  battlePresentation    BattleQuestionPresentation? @map("battle_presentation")
  battleDifficulty      BattleQuestionDifficulty?   @map("battle_difficulty")
  isBattleEnabled       Boolean                     @default(false) @map("is_battle_enabled")
  stemBlocks            Json?                       @map("stem_blocks")
  explanationBlocks     Json?                       @map("explanation_blocks")
  acceptedAnswers       Json?                       @map("accepted_answers")
  answerNormalization   Json?                       @map("answer_normalization")
  caseSensitive         Boolean                     @default(true) @map("case_sensitive")
  knowledgeTags         Json?                       @map("knowledge_tags")
  programmingLanguage   String?                     @map("programming_language")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  quiz                  Quiz                        @relation(fields: [quizId], references: [id])
  options               QuizOption[]
  answers               QuizAnswer[]
  battleQuestionSources BattleQuestionSnapshot[]    @relation("BattleQuestionSnapshotSource")

  @@unique([quizId, sortOrder])
  @@index([quizId])
  @@index([isBattleEnabled])
  @@map("quiz_questions")
}

model QuizOption {
  id                String       @id @default(uuid()) @db.Uuid
  questionId        String       @map("question_id") @db.Uuid
  content           String
  contentBlocks     Json?        @map("content_blocks")
  isCorrect         Boolean      @default(false) @map("is_correct")
  sortOrder         Int          @map("sort_order")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  question          QuizQuestion @relation(fields: [questionId], references: [id])
  selectedInAnswers QuizAnswer[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  quizId      String       @map("quiz_id") @db.Uuid
  score       Int
  totalScore  Int          @map("total_score")
  passed      Boolean      @default(false)
  submittedAt DateTime     @default(now()) @map("submitted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  user        User         @relation(fields: [userId], references: [id])
  quiz        Quiz         @relation(fields: [quizId], references: [id])
  answers     QuizAnswer[]

  @@index([userId, quizId])
  @@index([userId, quizId, passed])
  @@index([submittedAt])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String       @id @default(uuid()) @db.Uuid
  attemptId        String       @map("attempt_id") @db.Uuid
  questionId       String       @map("question_id") @db.Uuid
  selectedOptionId String       @map("selected_option_id") @db.Uuid
  isCorrect        Boolean      @default(false) @map("is_correct")
  scoreAwarded     Int          @default(0) @map("score_awarded")
  createdAt        DateTime     @default(now()) @map("created_at")
  attempt          QuizAttempt  @relation(fields: [attemptId], references: [id])
  question         QuizQuestion @relation(fields: [questionId], references: [id])
  selectedOption   QuizOption   @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("quiz_answers")
}

model BattleProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  rating           Int      @default(1000)
  highestRating    Int      @default(1000) @map("highest_rating")
  totalBattles     Int      @default(0) @map("total_battles")
  rankedBattles    Int      @default(0) @map("ranked_battles")
  friendBattles    Int      @default(0) @map("friend_battles")
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  currentWinStreak Int      @default(0) @map("current_win_streak")
  bestWinStreak    Int      @default(0) @map("best_win_streak")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id])

  @@map("battle_profiles")
}

model BattleRoom {
  id                String                   @id @default(uuid()) @db.Uuid
  mode              BattleMode
  status            BattleRoomStatus         @default(WAITING)
  questionCount     Int                      @default(20) @map("question_count")
  durationSeconds   Int                      @default(180) @map("duration_seconds")
  correctScore      Int                      @default(2) @map("correct_score")
  wrongScore        Int                      @default(-1) @map("wrong_score")
  unansweredScore   Int                      @default(0) @map("unanswered_score")
  createdByUserId   String?                  @map("created_by_user_id") @db.Uuid
  startedAt         DateTime?                @map("started_at")
  expiresAt         DateTime?                @map("expires_at")
  settledAt         DateTime?                @map("settled_at")
  completedAt       DateTime?                @map("completed_at")
  cancelledAt       DateTime?                @map("cancelled_at")
  endReason         BattleEndReason?         @map("end_reason")
  winnerUserId      String?                  @map("winner_user_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  createdByUser     User?                    @relation("BattleRoomCreatedBy", fields: [createdByUserId], references: [id])
  winnerUser        User?                    @relation("BattleRoomWinner", fields: [winnerUserId], references: [id])
  participants      BattleParticipant[]
  questionSnapshots BattleQuestionSnapshot[]
  answers           BattleAnswer[]
  invitation        BattleInvitation?
  ratingLogs        BattleRatingLog[]
  matchedQueues     BattleMatchQueue[]

  @@index([status])
  @@index([mode, status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("battle_rooms")
}

model BattleParticipant {
  id              String                  @id @default(uuid()) @db.Uuid
  battleRoomId    String                  @map("battle_room_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  status          BattleParticipantStatus @default(JOINED)
  result          BattleResult            @default(NONE)
  seat            Int
  score           Int                     @default(0)
  correctCount    Int                     @default(0) @map("correct_count")
  wrongCount      Int                     @default(0) @map("wrong_count")
  unansweredCount Int                     @default(0) @map("unanswered_count")
  ratingBefore    Int?                    @map("rating_before")
  ratingDelta     Int                     @default(0) @map("rating_delta")
  ratingAfter     Int?                    @map("rating_after")
  readyAt         DateTime?               @map("ready_at")
  submittedAt     DateTime?               @map("submitted_at")
  forfeitedAt     DateTime?               @map("forfeited_at")
  joinedAt        DateTime                @default(now()) @map("joined_at")
  completedAt     DateTime?               @map("completed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  battleRoom      BattleRoom              @relation(fields: [battleRoomId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])
  answers         BattleAnswer[]
  ratingLogs      BattleRatingLog[]

  @@unique([battleRoomId, userId])
  @@unique([battleRoomId, seat])
  @@index([userId])
  @@index([battleRoomId])
  @@index([status])
  @@map("battle_participants")
}

model BattleQuestionSnapshot {
  id                          String                     @id @default(uuid()) @db.Uuid
  battleRoomId                String                     @map("battle_room_id") @db.Uuid
  sourceQuizQuestionId        String?                    @map("source_quiz_question_id") @db.Uuid
  orderIndex                  Int                        @map("order_index")
  questionType                BattleQuestionType         @map("question_type")
  presentation                BattleQuestionPresentation
  difficulty                  BattleQuestionDifficulty?
  stemSnapshot                Json                       @map("stem_snapshot")
  optionsSnapshot             Json                       @map("options_snapshot")
  correctAnswerSnapshot       Json                       @map("correct_answer_snapshot")
  explanationSnapshot         Json?                      @map("explanation_snapshot")
  acceptedAnswersSnapshot     Json?                      @map("accepted_answers_snapshot")
  answerNormalizationSnapshot Json?                      @map("answer_normalization_snapshot")
  knowledgeTagsSnapshot       Json?                      @map("knowledge_tags_snapshot")
  programmingLanguage         String?                    @map("programming_language")
  courseIdSnapshot            String?                    @map("course_id_snapshot") @db.Uuid
  chapterIdSnapshot           String?                    @map("chapter_id_snapshot") @db.Uuid
  createdAt                   DateTime                   @default(now()) @map("created_at")
  battleRoom                  BattleRoom                 @relation(fields: [battleRoomId], references: [id])
  sourceQuizQuestion          QuizQuestion?              @relation("BattleQuestionSnapshotSource", fields: [sourceQuizQuestionId], references: [id], onDelete: SetNull)
  answers                     BattleAnswer[]

  @@unique([battleRoomId, orderIndex])
  @@index([battleRoomId])
  @@index([sourceQuizQuestionId])
  @@map("battle_question_snapshots")
}

model BattleAnswer {
  id                       String                 @id @default(uuid()) @db.Uuid
  battleRoomId             String                 @map("battle_room_id") @db.Uuid
  participantId            String                 @map("participant_id") @db.Uuid
  battleQuestionSnapshotId String                 @map("battle_question_snapshot_id") @db.Uuid
  userId                   String                 @map("user_id") @db.Uuid
  clientRequestId          String                 @map("client_request_id")
  answerVersion            Int                    @default(1) @map("answer_version")
  answerPayload            Json                   @map("answer_payload")
  normalizedAnswer         String?                @map("normalized_answer")
  isCorrect                Boolean                @default(false) @map("is_correct")
  scoreDelta               Int                    @default(0) @map("score_delta")
  submittedAt              DateTime               @map("submitted_at")
  timeSpentMs              Int?                   @map("time_spent_ms")
  createdAt                DateTime               @default(now()) @map("created_at")
  battleRoom               BattleRoom             @relation(fields: [battleRoomId], references: [id])
  participant              BattleParticipant      @relation(fields: [participantId], references: [id])
  battleQuestionSnapshot   BattleQuestionSnapshot @relation(fields: [battleQuestionSnapshotId], references: [id])
  user                     User                   @relation(fields: [userId], references: [id])

  @@unique([participantId, battleQuestionSnapshotId])
  @@unique([participantId, clientRequestId])
  @@index([userId])
  @@index([battleRoomId])
  @@index([participantId])
  @@map("battle_answers")
}

model BattleInvitation {
  id            String                 @id @default(uuid()) @db.Uuid
  battleRoomId  String                 @unique @map("battle_room_id") @db.Uuid
  inviterUserId String                 @map("inviter_user_id") @db.Uuid
  inviteeUserId String?                @map("invitee_user_id") @db.Uuid
  token         String                 @unique
  inviteCode    String?                @unique @map("invite_code")
  status        BattleInvitationStatus @default(ACTIVE)
  expiresAt     DateTime               @map("expires_at")
  acceptedAt    DateTime?              @map("accepted_at")
  cancelledAt   DateTime?              @map("cancelled_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  battleRoom    BattleRoom             @relation(fields: [battleRoomId], references: [id])
  inviterUser   User                   @relation("BattleInvitationInviter", fields: [inviterUserId], references: [id])
  inviteeUser   User?                  @relation("BattleInvitationInvitee", fields: [inviteeUserId], references: [id])

  @@index([status])
  @@index([expiresAt])
  @@map("battle_invitations")
}

model BattleRatingLog {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  battleRoomId  String?            @map("battle_room_id") @db.Uuid
  participantId String?            @map("participant_id") @db.Uuid
  reason        BattleRatingReason
  ratingBefore  Int                @map("rating_before")
  ratingDelta   Int                @map("rating_delta")
  ratingAfter   Int                @map("rating_after")
  createdAt     DateTime           @default(now()) @map("created_at")
  user          User               @relation(fields: [userId], references: [id])
  battleRoom    BattleRoom?        @relation(fields: [battleRoomId], references: [id])
  participant   BattleParticipant? @relation(fields: [participantId], references: [id])

  @@unique([battleRoomId, userId, reason])
  @@index([userId, createdAt])
  @@index([battleRoomId])
  @@map("battle_rating_logs")
}

model BattleMatchQueue {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @unique @map("user_id") @db.Uuid
  status              BattleMatchQueueStatus @default(CANCELLED)
  ratingSnapshot      Int                    @map("rating_snapshot")
  matchedBattleRoomId String?                @map("matched_battle_room_id") @db.Uuid
  searchStartedAt     DateTime?              @map("search_started_at")
  matchedAt           DateTime?              @map("matched_at")
  cancelledAt         DateTime?              @map("cancelled_at")
  expiresAt           DateTime?              @map("expires_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  user                User                   @relation(fields: [userId], references: [id])
  matchedBattleRoom   BattleRoom?            @relation(fields: [matchedBattleRoomId], references: [id])

  @@index([status])
  @@index([expiresAt])
  @@map("battle_match_queues")
}

model CommunityCategory {
  id          String                  @id @default(uuid()) @db.Uuid
  key         String                  @unique
  name        String
  description String?
  sortOrder   Int                     @default(0) @map("sort_order")
  status      CommunityCategoryStatus @default(ENABLED)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  posts       CommunityPost[]

  @@index([status, sortOrder])
  @@map("community_categories")
}

model CommunityPost {
  id            String                     @id @default(uuid()) @db.Uuid
  authorId      String                     @map("author_id") @db.Uuid
  categoryId    String                     @map("category_id") @db.Uuid
  title         String
  content       String
  status        CommunityPostStatus        @default(PUBLISHED)
  likeCount     Int                        @default(0) @map("like_count")
  commentCount  Int                        @default(0) @map("comment_count")
  favoriteCount Int                        @default(0) @map("favorite_count")
  viewCount     Int                        @default(0) @map("view_count")
  deletedAt     DateTime?                  @map("deleted_at")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  author        User                       @relation(fields: [authorId], references: [id])
  category      CommunityCategory          @relation(fields: [categoryId], references: [id])
  images        CommunityPostImage[]
  favorites     CommunityPostFavorite[]
  histories     CommunityPostViewHistory[]
  likes         CommunityPostLike[]
  comments      CommunityComment[]

  @@index([categoryId, status, createdAt])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("community_posts")
}

model CommunityPostImage {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  objectKey String?       @map("object_key")
  url       String
  width     Int?
  height    Int?
  sortOrder Int           @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id])

  @@index([postId, sortOrder])
  @@map("community_post_images")
}

model CommunityPostFavorite {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId])
  @@map("community_post_favorites")
}

model CommunityPostViewHistory {
  id            String        @id @default(uuid()) @db.Uuid
  postId        String        @map("post_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  firstViewedAt DateTime      @default(now()) @map("first_viewed_at")
  lastViewedAt  DateTime      @default(now()) @map("last_viewed_at")
  viewCount     Int           @default(1) @map("view_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  post          CommunityPost @relation(fields: [postId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId, lastViewedAt])
  @@index([postId])
  @@map("community_post_view_histories")
}

model CommunityPostLike {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId])
  @@map("community_post_likes")
}

model CommunityComment {
  id        String                 @id @default(uuid()) @db.Uuid
  postId    String                 @map("post_id") @db.Uuid
  authorId  String                 @map("author_id") @db.Uuid
  content   String
  status    CommunityCommentStatus @default(PUBLISHED)
  deletedAt DateTime?              @map("deleted_at")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  post      CommunityPost          @relation(fields: [postId], references: [id])
  author    User                   @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@map("community_comments")
}
